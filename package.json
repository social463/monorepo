{
  "name": "legends",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @legends/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @legends/api exec prisma generate",
    "db:seed": "pnpm --filter @legends/api run db:seed"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.5.4"
  }
}
