DATABASE_URL="postgresql://legends:legends@localhost:5432/legends?schema=public"
JWT_SECRET="troque-este-segredo"
PORT=3333

# URL pública do app (base do link de CTA nos cards do Teams). Default: produção.
APP_BASE_URL="https://legends.eumedicoresidente.com.br"

# Geração do texto do Destaque do Mês (opcional em dev; obrigatório para gerar de verdade).
# ATENÇÃO: esta chave serve SÓ ao card do Destaque do Mês. Os agentes de IA
# (Benchmarking etc.) NÃO a usam — cada empresa cadastra a própria chave em
# Administração › Inteligência Artificial, cifrada em AppSetting. Foi decisão de
# projeto não ter fallback: sem isso, todo tenant novo gastaria esta cota em silêncio.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Chave de 32 bytes em base64 para cifrar segredos em repouso: credenciais/tokens
# de calendário E a chave da API Gemini de cada empresa (lib/crypto.ts).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção. Perdê-la torna ilegível toda credencial já gravada.
CALENDAR_ENCRYPTION_KEY=""

# Busca de GIFs na Resenha (opcional). Sem GIPHY_API_KEY, o recurso fica oculto.
# Crie uma chave gratuita em https://developers.giphy.com (Create an App → API).
GIPHY_API_KEY=

# Upload de imagens na Resenha, tilesets do editor de mapas e cards do Destaque
# do Mês (S3). Sem estas variáveis, tilesets novos retornam 503 (mapa legado
# continua disponível) e "gerar imagem do destaque" retorna 503.
S3_BUCKET=
S3_REGION=us-east-1
# Base pública dos objetos (bucket público ou CloudFront), sem barra final.
S3_PUBLIC_BASE_URL=
# Credenciais AWS: em produção prefira IAM role na EC2 (provider chain padrão do SDK).
# Em dev, exporte AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY no ambiente.
# CORS do bucket precisa permitir PUT a partir da origem do app (método PUT, header Content-Type).

# LiveKit (mídia do escritório) — servidor EXISTENTE, não operamos um.
# Os três são obrigatórios em produção. LIVEKIT_URL é a URL que os NAVEGADORES
# usam para conectar (ex.: wss://livekit.suaempresa.com). Peça as credenciais
# a quem administra o servidor.
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
#LIVEKIT_URL=

# Hosts liberados para painéis de RH embutidos (CSV). Vazio = app.powerbi.com,
# lookerstudio.google.com, datastudio.google.com. O host do Metabase interno entra aqui.
# Precisa bater com o frame-src do CSP em nginx/default.conf.
HR_DASHBOARD_ALLOWED_HOSTS=

# Google Analytics 4 (Measurement Protocol, server-side).
# OPCIONAL, inclusive em produção: sem as duas variáveis o sink do GA4 some e só
# o Postgres grava — o painel de adoção do super-admin continua funcionando.
# Derrubar o boot da API por falta de chave de métrica trocaria perda de dado
# por indisponibilidade, então `resolveGa4Config` devolve null em vez de lançar.
#
# GA4_MEASUREMENT_ID: o "G-XXXXXXXXXX" da propriedade (Admin › Fluxos de dados).
# GA4_API_SECRET: criado em Admin › Fluxos de dados › Measurement Protocol.
#   É SEGREDO — nunca vai para o front (lá vai só o VITE_GA4_MEASUREMENT_ID).
# GA4_DEBUG=true manda para /debug/mp/collect, que valida o payload e NÃO grava.
#   Use ao configurar: fora do debug o GA4 responde 204 mesmo para payload
#   inválido, e evento descartado nunca aparece como erro.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
#GA4_DEBUG=true

# Envio de notificações ao Teams. Deixe vazio (ou `true`) em produção; `false`
# desliga todo webhook de saída — é o que se usa no ambiente local, onde o
# webhook gravado no banco costuma ser o da empresa de verdade.
TEAMS_NOTIFICATIONS_ENABLED=
