    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@google/genai": "^2.8.0",
    "@legends/shared": "workspace:*",
    "@prisma/client": "^5.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
