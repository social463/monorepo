// Mural corporativo: mesmo formato da resenha, porém da EMPRESA inteira —
// sem `sectorId`, de propósito: o isolamento aqui é só de empresa (companyId).
// Quem publica é filtrado por papel no service (lideranças + administração).
model CorporatePost {
  id          String    @id @default(cuid())
  authorId    String
  /// Título opcional. A web dá o destaque (negrito, corpo maior) — o autor não
  /// formata na mão, senão cada comunicado sairia com um destaque diferente.
  title       String?
  /// Texto PURO do comunicado. Continua sendo a fonte de compatibilidade:
  /// post antigo, publicação de campanha, excerto do alcance, prévia da Home e
  /// notificação leem daqui, sem saber que existe texto rico.
  content     String
  /// Documento rico (ver `packages/shared/src/rich-text.ts`). Null nos posts
  /// que já existiam, que são texto puro. NUNCA guarda HTML — o formato é a
  /// estrutura fechada validada pelo Zod da rota.
  contentJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Última edição DO TEXTO — é isto que vira a marca "editado" no card.
  /// Não dá para usar `updatedAt`: ele muda ao fixar, ao aprovar e a qualquer
  /// UPDATE, e marcaria como editado um post em que ninguém tocou.
  editedAt    DateTime?
  gifUrl      String?
  gifWidth    Int?
  gifHeight   Int?
  imageUrl    String?
  imageWidth  Int?
  imageHeight Int?
  companyId   String    @default("company-emr")
  pinnedAt    DateTime?
  pinnedById  String?

  /// PUBLISHED por default de propósito: as linhas que já existem foram todas
  /// escritas por quem publica direto, e a coluna nasce sem backfill.
  status          CorporatePostStatus   @default(PUBLISHED)
  /// Instante marcado para a publicação (Documento 4, seção 12). Só existe em
  /// post SCHEDULED; nulo em todo o resto. Quem agenda é quem publica direto —
  /// marcar data para um post que ainda pode ser recusado é prometer o que não
  /// se controla.
  publishAt       DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  audienceScope   CorporatePostAudience @default(ALL)
  /// Tipo de comunicação (Institucional, Benefícios, Treinamento…). Opcional:
  /// todo comunicado já publicado nasceria inválido com ela obrigatória, e o
  /// painel de Comunicação Interna precisa mesmo do balde "Sem categoria".
  tagId           String?

  author       User                      @relation("CorporatePostsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  comments     CorporatePostComment[]
  reactions    CorporatePostReaction[]
  mentions     CorporatePostMention[]
  company      Company                   @relation(fields: [companyId], references: [id])
  pinnedBy     User?                     @relation("CorporatePostsPinned", fields: [pinnedById], references: [id], onDelete: SetNull)
  reviewedBy   User?                     @relation("CorporatePostsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reads        CorporatePostRead[]
  tag          CorporatePostTag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)
  sectors      CorporatePostSector[]
  attachments  CorporatePostAttachment[]
  poll         CorporatePostPoll?
  campaignPost CampaignPost?

  @@index([createdAt])
  @@index([authorId])
  @@index([companyId])
  @@index([companyId, pinnedAt])
  @@index([companyId, status, createdAt])
}

/// Público-alvo do post quando `audienceScope` é SECTORS. Vazio com escopo ALL.
/// Tipo de comunicação do Feed Corporativo — o que a G&G chama de "tag"
/// (Documento 3, seção 13). Catálogo **por empresa**, editável em Administração.
///
/// No molde de `CalendarEventType`, que resolve o mesmo problema no calendário:
/// nome, slug, cor e unique por empresa. A cor não é enfeite — no filtro do topo
/// do Feed as tags aparecem lado a lado, e sem ela a lista vira meia dúzia de
/// pílulas cinzas indistinguíveis.
///
/// Tag é **desativada**, nunca apagada: apagar deixaria comunicado órfão e
/// sumiria com a série histórica do painel de Comunicação Interna. Mesma regra
/// de `RecognitionCategory`.
model CorporatePostTag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  color     String   @default("#6CE190")
  active    Boolean  @default(true)
  order     Int      @default(0)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  posts   CorporatePost[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model CorporatePostSector {
  id        String @id @default(cuid())
  postId    String
  sectorId  String
  companyId String @default("company-emr")

  post    CorporatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sector  Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id])

  @@unique([postId, sectorId])
  @@index([companyId, sectorId])
}

/// Anexos do post: foto, vídeo e documento. Tabela à parte porque são vários
/// por post; `gifUrl`/`imageUrl` do post continuam existindo para não exigir
/// backfill das linhas antigas (o DTO devolve a imagem legada nesta mesma lista).
model CorporatePostAttachment {
  id          String                      @id @default(cuid())
  postId      String
  kind        CorporatePostAttachmentKind
  url         String
  name        String
  contentType String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime                    @default(now())
  companyId   String                      @default("company-emr")

  post    CorporatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id])

  @@index([postId])
  @@index([companyId])
}

/// Enquete do post do Feed (spec 2026-09-08). Model próprio, e não um `kind`
/// novo em `CorporatePostAttachment`: aquela tabela é de arquivo enviado —
/// deriva o kind do content-type, valida tamanho e exige URL do bucket. Enquete
/// não tem nenhum dos três, e entraria lá como uma linha de nulos.
///
/// Só `companyId`, acompanhando o `CorporatePost` — a família do Feed não tem
/// `sectorId`, ao contrário da `ReviewPoll`, que é copiada no resto.
model CorporatePostPoll {
  id        String   @id @default(cuid())
  postId    String   @unique
  question  String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  post    CorporatePost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  company Company                   @relation(fields: [companyId], references: [id])
  options CorporatePostPollOption[]
  votes   CorporatePostPollVote[]

  @@index([companyId])
}

model CorporatePostPollOption {
  id        String @id @default(cuid())
  pollId    String
  text      String
  /// Ordem em que a opção foi escrita. É o que mantém a enquete estável entre
  /// leituras — sem ela a lista sairia na ordem que o banco quisesse.
  position  Int
  companyId String @default("company-emr")

  poll    CorporatePostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  company Company                 @relation(fields: [companyId], references: [id])
  votes   CorporatePostPollVote[]

  @@unique([pollId, position])
  @@index([pollId])
  @@index([companyId])
}

model CorporatePostPollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  poll    CorporatePostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option  CorporatePostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user    User                    @relation("CorporatePostPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  company Company                 @relation(fields: [companyId], references: [id])

  /// Um voto por pessoa. É a trava de verdade: a checagem no service evita o
  /// caminho feliz, e esta unique cobre a corrida entre dois cliques.
  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
  @@index([companyId])
}

