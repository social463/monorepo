  ELAPSED
  COUNTDOWN
}

enum RetroTimerStatus {
  IDLE
  RUNNING
  PAUSED
}

model Feedback {
  id                         String           @id @default(cuid())
  authorId                   String
  targetId                   String
  /// Voto que originou este feedback, quando ele nasceu da votação. Único: a
  /// materialização roda a cada publicação de destaque e não pode duplicar.
  voteId                     String?          @unique
  message                    String
  category                   FeedbackCategory
  /// Competência escrita à mão, quando o catálogo da G&G não cobre o caso.
  /// Vive fora do catálogo de propósito: é exceção, não item administrável.
  customCategory             String?
  developmentThursdayEventId String?
  sharedAt                   DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  companyId                  String           @default("company-emr")

  author                   User                          @relation("FeedbacksGiven", fields: [authorId], references: [id])
  target                   User                          @relation("FeedbacksReceived", fields: [targetId], references: [id])
  vote                     Vote?                         @relation(fields: [voteId], references: [id], onDelete: SetNull)
  developmentThursdayEvent DevelopmentThursdayEvent?     @relation(fields: [developmentThursdayEventId], references: [id], onDelete: SetNull)
  reactions                FeedbackReaction[]
  recipients               FeedbackRecipient[]
  recognitionCategories    FeedbackRecognitionCategory[]
  comments                 FeedbackComment[]
  company                  Company                       @relation(fields: [companyId], references: [id])

  @@index([targetId])
  @@index([authorId])
  @@index([developmentThursdayEventId])
  @@index([targetId, category])
  @@index([sharedAt])
  @@index([companyId])
}

/// Destinatários de um feedback. O reconhecimento grupal é UM feedback com N
/// pessoas (e, portanto, UMA conversa de reações e comentários) — N feedbacks
/// independentes dariam N conversas paralelas sobre o mesmo texto.
///
/// O destinatário principal (`Feedback.targetId`, que continua existindo para o
/// perfil, a Quinta de Dev e os selos) entra AQUI TAMBÉM, de propósito: assim
/// toda leitura de "quem recebeu" tem um caminho só.
model FeedbackRecipient {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([feedbackId, userId])
  @@index([userId])
  @@index([companyId])
}

/// Catálogo de competências administrado pela G&G (Administração ›
/// Reconhecimento). As 13 do documento entram por seed, não cravadas no código:
/// cada empresa ajusta a lista dela.
/// Catálogo único de categorias da empresa: vale para o feedback e para o voto.
/// Antes eram dois (este e `Category`, do voto) — ver
/// `specs/2026-08-20-unificar-reconhecimento-em-feedback-design.md`.
model RecognitionCategory {
  id          String   @id @default(cuid())
  name        String
  /// Identificador estável: o nome a G&G renomeia, o slug não. É por ele que
  /// `Badge.categorySlug` aponta e que o front escolhe o ícone.
  slug        String
  /// Texto de apoio no seletor de voto; herdado do catálogo aposentado.
  description String?
  /// Ordem de exibição no seletor; empate cai no nome.
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("company-emr")

  company        Company                       @relation(fields: [companyId], references: [id])
  feedbacks      FeedbackRecognitionCategory[]
  voteCategories VoteCategory[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
}

/// Competências de um feedback (N por feedback, escolhidas no envio).
model FeedbackRecognitionCategory {
  id         String @id @default(cuid())
  feedbackId String
  categoryId String
  companyId  String @default("company-emr")

  feedback Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  category RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company             @relation(fields: [companyId], references: [id])

  @@unique([feedbackId, categoryId])
  @@index([categoryId])
  @@index([companyId])
}

/// Resposta pública a um feedback. Quem enxerga o feedback enxerga o
/// comentário — a checagem é a mesma `canViewFeedback`, sem caminho paralelo de
/// visibilidade para manter em dia.
model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String
  message    String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([feedbackId])
  @@index([companyId])
}

model FeedbackReaction {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([feedbackId, userId, emoji])
  @@index([feedbackId])
  @@index([companyId])
}

/// Um período de férias de um colaborador, lançado pelo gestor ou pelo admin.
/// `@db.Date` porque férias são datas civis: sem hora, sem fuso — mesmo motivo
/// de `User.birthDate`.
model Vacation {
  id          String   @id @default(cuid())
  userId      String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  note        String?
  createdById String
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User    @relation("Vacations", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User    @relation("VacationsCreated", fields: [createdById], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, startDate])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  actorId   String?
  title     String
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  companyId String           @default("company-emr")

  user    User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([companyId])
}

model RetroRoom {
  id                      String           @id @default(cuid())
  sprint                  Int
  createdById             String
  anonymous               Boolean          @default(false)
  votesPerParticipant     Int
  status                  RetroRoomStatus  @default(OPEN)
  timerMode               RetroTimerMode   @default(ELAPSED)
  timerStatus             RetroTimerStatus @default(IDLE)
  timerDurationSeconds    Int?
  timerStartedAt          DateTime?
  timerAccumulatedSeconds Int              @default(0)
  timerUpdatedAt          DateTime         @default(now())
  timerUpdatedById        String?
  createdAt               DateTime         @default(now())
  concludedAt             DateTime?
  archivedAt              DateTime?
  archivedById            String?
  companyId               String           @default("company-emr")

  creator        User               @relation("RetroRoomsCreated", fields: [createdById], references: [id])
  archivedBy     User?              @relation("RetroRoomsArchived", fields: [archivedById], references: [id], onDelete: SetNull)
  timerUpdatedBy User?              @relation("RetroTimerUpdatedBy", fields: [timerUpdatedById], references: [id], onDelete: SetNull)
  squads         RetroRoomSquad[]
  participants   RetroParticipant[]
  cards          RetroCard[]
  edits          RetroEdit[]
  company        Company            @relation(fields: [companyId], references: [id])

  @@index([createdById])
  @@index([timerUpdatedById])
  @@index([companyId])
}

model RetroRoomSquad {
  id        String @id @default(cuid())
  roomId    String
  squadId   String
  companyId String @default("company-emr")

  room    RetroRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  squad   Squad     @relation(fields: [squadId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@unique([roomId, squadId])
  @@index([squadId])
  @@index([companyId])
}

model RetroParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  invitedAt DateTime @default(now())
  companyId String   @default("company-emr")

  room    RetroRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User      @relation("RetroParticipations", fields: [userId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
  @@index([companyId])
