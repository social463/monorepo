// Configurações globais do escritório virtual (linha única, id = 1).
// broadcastEnabled é o interruptor de CUSTO do alto-falante: desligado,
// nenhum cliente abre a conexão LiveKit extra de broadcast.
model OfficeSetting {
  companyId              String   @id
  broadcastEnabled       Boolean  @default(false)
  activeMapPublicationId String?  @unique
  updatedAt              DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id])
  activeMapPublication OfficeMapPublication? @relation("ActiveOfficeMapPublication", fields: [activeMapPublicationId], references: [id], onDelete: SetNull)
}

model OfficeMap {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String   @default("company-emr")

  company      Company                @relation(fields: [companyId], references: [id])
  draft        OfficeMapDraft?
  assets       OfficeMapAsset[]
  editLock     OfficeMapEditLock?
  publications OfficeMapPublication[]

  @@index([companyId])
}

model OfficeMapDraft {
  id             String   @id @default(cuid())
  mapId          String   @unique
  document       Json
  revision       Int      @default(0)
  lastEditedById String?
  savedAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  companyId      String   @default("company-emr")

  // Âncora do merge 3-vias com o mapa vivo: de qual publicação/`decorRevision`
  // este rascunho foi semeado. Sem relação declarada de propósito — a
  // publicação pode ser podada, e aí a âncora simplesmente vira desconhecida
  // (merge aditivo) em vez de virar erro de FK.
  basePublicationId String?
  baseDecorRevision Int?

  map          OfficeMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  lastEditedBy User?     @relation("OfficeMapDraftEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  company      Company   @relation(fields: [companyId], references: [id])

  @@index([lastEditedById])
  @@index([companyId])
}

model OfficeMapAsset {
  id          String   @id @default(cuid())
  mapId       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int
  height      Int
  checksum    String
  storageKey  String   @unique
  createdById String?
  createdAt   DateTime @default(now())
  companyId   String   @default("company-emr")

  map              OfficeMap                   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  createdBy        User?                       @relation("OfficeMapAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publicationLinks OfficeMapPublicationAsset[]
  company          Company                     @relation(fields: [companyId], references: [id])

  @@unique([mapId, checksum])
  @@index([mapId])
  @@index([createdById])
  @@index([companyId])
}

model OfficeMapEditLock {
  id        String   @id @default(cuid())
  mapId     String   @unique
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String   @default("company-emr")

  map     OfficeMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user    User      @relation("OfficeMapLockOwner", fields: [userId], references: [id], onDelete: Cascade)
  company Company   @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([companyId])
}

// `version` identifica a publicação e só avança em publish estrutural.
// `decorRevision` conta os saves de decoração aplicados IN-PLACE sobre esta
// mesma publicação — é o token de concorrência otimista do editor colaborativo,
// no lugar que `version` ocupava antes de a decoração parar de publicar.
model OfficeMapPublication {
  id            String   @id @default(cuid())
  mapId         String
  createdById   String?
  version       Int
  decorRevision Int      @default(0)
  schemaVersion String
  mapData       Json
  createdAt     DateTime @default(now())
  companyId     String   @default("company-emr")

  map            OfficeMap                   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  createdBy      User?                       @relation("OfficeMapPublicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assetLinks     OfficeMapPublicationAsset[]
  rooms          OfficeRoom[]
  desks          OfficeDesk[]
  decorRevisions OfficeMapDecorRevision[]
  activeSetting  OfficeSetting?              @relation("ActiveOfficeMapPublication")
  company        Company                     @relation(fields: [companyId], references: [id])

  @@unique([mapId, version])
  @@index([createdById])
  @@index([companyId])
}

// Anel de snapshots do `mapData` de uma publicação. Cada linha guarda o
// documento que esteve ativo ENQUANTO a publicação tinha aquele
// `decorRevision`, e é escrita no momento em que um save de decoração o
// substitui. Serve de base para o merge de 3 vias (o editor abriu o documento
// da revisão X e pode salvar depois de outra pessoa) e de histórico curto da
// decoração. Mantido em OFFICE_DECOR_REVISION_RING linhas por publicação.
model OfficeMapDecorRevision {
  id            String   @id @default(cuid())
  publicationId String
  revision      Int
  mapData       Json
  createdById   String?
  createdAt     DateTime @default(now())
  companyId     String   @default("company-emr")

  publication OfficeMapPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation("OfficeMapDecorRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  company     Company              @relation(fields: [companyId], references: [id])

  @@unique([publicationId, revision])
  @@index([publicationId])
  @@index([createdById])
  @@index([companyId])
}

model OfficeMapPublicationAsset {
  publicationId String
  assetId       String
  createdAt     DateTime @default(now())
  companyId     String   @default("company-emr")

  publication OfficeMapPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  asset       OfficeMapAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  company     Company              @relation(fields: [companyId], references: [id])

  @@id([publicationId, assetId])
  @@index([assetId])
  @@index([companyId])
}

model OfficeRoom {
  id               String                 @id @default(cuid())
  mapPublicationId String
  name             String
  externalKey      String
  status           OfficeRoomStatus       @default(OPEN)
  capacity         Int?
  voiceEnabled     Boolean                @default(true)
  accessPolicy     OfficeRoomAccessPolicy @default(OPEN)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  companyId        String                 @default("company-emr")

  mapPublication OfficeMapPublication    @relation(fields: [mapPublicationId], references: [id], onDelete: Cascade)
  accessGrants   OfficeRoomAccessGrant[]
  company        Company                 @relation(fields: [companyId], references: [id])

  @@unique([mapPublicationId, externalKey])
  @@index([mapPublicationId])
  @@index([companyId])
}

model OfficeRoomAccessGrant {
  roomId    String
  userId    String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  room    OfficeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@id([roomId, userId])
  @@index([userId])
  @@index([companyId])
}

model OfficeDesk {
  id               String   @id @default(cuid())
  mapPublicationId String
  name             String
  externalKey      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyId        String   @default("company-emr")

  mapPublication OfficeMapPublication @relation(fields: [mapPublicationId], references: [id], onDelete: Cascade)
  claim          OfficeDeskClaim?
  reminders      OfficeDeskReminder[]
  company        Company              @relation(fields: [companyId], references: [id])

  @@unique([mapPublicationId, externalKey])
  @@index([mapPublicationId])
  @@index([companyId])
}

model OfficeDeskClaim {
  deskId    String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  desk    OfficeDesk @relation(fields: [deskId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model CalendarConnection {
  id                   String                   @id @default(cuid())
  userId               String
  companyId            String
  provider             CalendarProvider
  providerAccountEmail String
  /// Cifrado por lib/crypto.ts — nunca sai da API.
  accessTokenEnc       String
  accessTokenExpiresAt DateTime
  /// Cifrado por lib/crypto.ts — nunca sai da API.
  refreshTokenEnc      String
  scopes               String
  status               CalendarConnectionStatus @default(ACTIVE)
  /// Fase 3: opt-out de publicar eventos do Legends nesta agenda.
  publishEnabled       Boolean                  @default(true)
  /// Fase 2: syncToken (Google) / deltaLink (Graph).
  syncCursor           String?
  lastSyncAt           DateTime?
  lastSyncError        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, provider])
  @@index([companyId])
  @@index([status])
}

model OfficeDeskReminder {
  id          String    @id @default(cuid())
  deskId      String
  senderId    String
  recipientId String
  message     String
  giftX       Float     @default(0.5)
  giftY       Float     @default(0.35)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  companyId   String    @default("company-emr")

  desk      OfficeDesk @relation(fields: [deskId], references: [id], onDelete: Cascade)
  sender    User       @relation("OfficeDeskReminderSender", fields: [senderId], references: [id])
  recipient User       @relation("OfficeDeskReminderRecipient", fields: [recipientId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])

  @@index([deskId, readAt])
  @@index([recipientId, readAt])
  @@index([senderId])
  @@index([companyId])
}

model OfficeMeeting {
  id              String    @id @default(cuid())
  companyId       String    @default("company-emr")
  roomExternalKey String
  roomName        String
  title           String
  agenda          String?
  startsAt        DateTime
  endsAt          DateTime
  organizerId     String
  canceledAt      DateTime?
  // Outlook/Google só atualizam um evento já importado se o SEQUENCE subir.
  sequence        Int       @default(0)
  remindedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizer    User                       @relation("OfficeMeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  company      Company                    @relation(fields: [companyId], references: [id])
  participants OfficeMeetingParticipant[]

  @@index([companyId, roomExternalKey, startsAt])
  @@index([organizerId])
  @@index([startsAt])
}

model OfficeMeetingParticipant {
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  meeting OfficeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User          @relation("OfficeMeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

/// Página de conteúdo institucional da área de Cultura (hoje só o manifesto).
/// Genérica de propósito: kit visual e galeria entram como novos slugs.
model CulturePage {
  id          String   @id @default(cuid())
  slug        String
  title       String
  subtitle    String?
  /// Corpo em Markdown — renderizado no front sem passar por HTML.
  body        String   @db.Text
  published   Boolean  @default(false)
  updatedById String?
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User?   @relation("CulturePagesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([slug, companyId])
  @@index([companyId])
}

/// Manual interno (código de ética, política de bonificação…). O PDF fica no S3
/// e é referenciado pela CHAVE do objeto — nunca por URL pública, porque o
/// download precisa passar pela rota autenticada.
model CultureManual {
  id             String   @id @default(cuid())
  title          String
  description    String
  body           String?  @db.Text
  fileKey        String?
  fileName       String?
  fileSize       Int?
  /// Texto livre exibido no card, ex.: "Atualizado em junho/2024".
  referenceLabel String?
  order          Int      @default(0)
  published      Boolean  @default(true)
  companyId      String   @default("company-emr")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

/// Benefício ou canal de apoio exibido em card, com detalhe em modal.
model CultureBenefit {
  id        String   @id @default(cuid())
  title     String
  summary   String
  /// Nome do Material Symbol exibido no card.
  icon      String?
  body      String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

/// Como a imagem preenche o card do kit visual. CONTAIN existe para logo e selo,
/// que recortados perdem a forma; COVER para arte que sangra (banner, fundo).
enum CultureVisualAssetFit {
  COVER
  CONTAIN
}

/// A qual das duas identidades visuais a peça pertence (Documento 4, seção 7).
/// A EMR tem duas marcas em uso ao mesmo tempo, e a regra de uso é diferente
/// em cada uma — misturá-las na mesma grade fazia o colaborador levar a marca
/// nova para fora da empresa.
enum CultureVisualAssetBrand {
  /// Uso interno e externo, até a divulgação oficial da nova marca.
  CURRENT
  /// Uso restrito ao ambiente interno.
  NEW
}

/// Peça do kit de identidade visual (banner de LinkedIn, logotipo, fundo de
/// reunião). Diferente de CultureManual, a imagem NÃO é um anexo do card: ela é
/// o próprio produto — o mesmo objeto serve de preview e de download. Por isso
/// `storageKey` é obrigatório, e o prefixo é público (`visual-assets/`), ao
/// contrário do PDF de manual, que passa por rota autenticada.
model CultureVisualAsset {
  id          String                  @id @default(cuid())
  title       String
  description String
  /// Chave do objeto no S3. A URL pública é resolvida no serialize, como em
  /// EventPhoto — nunca gravada, para a base pública poder mudar sem migration.
  storageKey  String
  /// Nome sugerido no download, ex.: `EMR-Banner-LinkedIn.png`.
  fileName    String
  fit         CultureVisualAssetFit   @default(COVER)
  /// CURRENT por default: toda peça já publicada nasceu antes de a nova marca
  /// existir, então o default é o backfill — não há UPDATE de migração.
  brand       CultureVisualAssetBrand @default(CURRENT)
  order       Int                     @default(0)
  published   Boolean                 @default(true)
  companyId   String                  @default("company-emr")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

enum CulturePersonalAssetKind {
  IMAGE
  DOCUMENT
}

/// Material do kit entregue a UMA pessoa: foto do ensaio, certificado, carta.
///
/// Tabela separada de CultureVisualAsset, e a diferença é de segurança, não de
/// forma: a peça global mora em prefixo PÚBLICO do S3 e o DTO leva a URL direta;
/// aqui o prefixo é privado, `storageKey` nunca sai do servidor e o acesso passa
/// por link assinado de curta duração. Um `recipientId` opcional na mesma tabela
/// significaria que um valor errado publica a foto de alguém num CDN — e URL
/// vazada não se revoga.
model CulturePersonalAsset {
  id          String                   @id @default(cuid())
  /// Quem recebe. Um só por material: entrega para outra pessoa é outro envio.
  recipientId String
  title       String
  description String?
  /// Chave do objeto no S3, em prefixo privado. Nunca serializada.
  storageKey  String
  fileName    String
  fileSize    Int?
  kind        CulturePersonalAssetKind
  /// Quem publicou. SetNull para o material sobreviver à saída de quem o enviou.
  createdById String?
  companyId   String                   @default("company-emr")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  recipient User    @relation("CulturePersonalAssetsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CulturePersonalAssetsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, recipientId, createdAt])
  @@index([createdById])
}

/// Registro de navegação autenticada, base do People Analytics (`/admin/pessoas`).
/// Guarda só o *pathname* já normalizado (`/perfil/:id`) — nunca query string,
/// nunca PII além do `userId`.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  path      String
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  user    User    @relation("AccessLogs", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

/// Evento de uso do produto: quem exercitou qual fluxo, de qual empresa e setor.
///
/// Três registros vizinhos, propósitos distintos — não fundir:
/// - `AccessLog` é navegação (qual tela), base do People Analytics.
/// - `AdminAuditLog` é ação de admin sobre entidade, com before/after, e existe
///   para prestar contas.
/// - este é uso de produto, e sustenta o painel de adoção do super-admin.
///
/// `sectorId` é **snapshot denormalizado**, não relação: o setor que vale é o
/// de quando o evento aconteceu. Derivar por join com `User` faria quem muda de
/// setor levar todo o histórico junto, e a série por setor mentiria sobre o
/// passado.
///
/// `props` nunca recebe texto escrito por pessoa (justificativa de voto,
/// feedback) — só identificadores e contadores. Ver `@legends/shared/analytics`.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  sectorId   String?
  companyId  String   @default("company-emr")
  source     String   @default("api")
  props      Json?
  occurredAt DateTime @default(now())

  /// `SetNull`, não `Cascade`: apagar a pessoa apaga o vínculo com ela, mas
  /// preserva o agregado da empresa. Atende o direito à eliminação da LGPD sem
  /// abrir buraco retroativo no painel de adoção.
  user    User?   @relation("AnalyticsEvents", fields: [userId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, name, occurredAt])
  @@index([companyId, sectorId, occurredAt])
  @@index([name, occurredAt])
}

// ============================================================================
// Desenvolvimento — Aprendizado (LMS) e PDI
// ============================================================================

enum CourseStatus {
  DRAFT
  REVIEW
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseEnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum CertificateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// De onde a solicitação veio. `EXTERNAL` é o certificado de curso feito FORA,
/// que até o Documento 4 entrava por um formulário do Notion. Uma origem, e não
/// duas entidades: mesma fila, mesma aprovação, mesmo histórico.
enum CertificateRequestOrigin {
  INTERNAL
  EXTERNAL
}

enum TrainingType {
  COMPLIANCE
  TECNICO
  COMPORTAMENTAL
}

enum TrainingSponsor {
  GRATUITO
  EMR
  PROPRIO
  OUTRO
}

enum TrainingReason {
  INICIATIVA_PROPRIA
  SOLICITACAO_GESTOR
  LNT
  PDI
  OBRIGATORIO
}

/// Validação da G&G sobre o registro de treinamento. Outro eixo que a
/// participação: aqui a pergunta é "o comprovante confere?".
enum TrainingValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PdiPlanStatus {
  DRAFT
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PdiActionStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  DONE
}

enum PdiActionType {
  COURSE
  BOOK
  MENTORING
  PRACTICE
  OTHER
}

enum PdiActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum PdiShowcaseVisibility {
  ALL
  TEAM
  LEADER
  PRIVATE
}

enum PdiEvidenceKind {
  COMPLETION
  APPLICATION
}

enum PdiActionEventType {
  CREATED
  PROGRESS_UPDATED
  SUBMITTED_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}

/// Curso do catálogo de Aprendizado. Só curso publicado aparece para o colaborador.
model Course {
  id                          String       @id @default(cuid())
  title                       String
  slug                        String
  shortDescription            String?
  description                 String?      @db.Text
  coverUrl                    String?
  /// Identidade visual do curso (Documento 4, seção 9.6, passo 2). `icon` é
  /// emoji e `primaryColor` é hex — os dois vestem o card quando não há capa,
  /// que é o caso da maioria dos cursos internos.
  bannerUrl                   String?
  introVideoUrl               String?
  icon                        String?
  primaryColor                String?
  /// Categoria do catálogo (Documento 4, seção 9.6). Era `category String` —
  /// texto livre, que fazia "Liderança" e "liderança " virarem duas.
  categoryId                  String?
  level                       CourseLevel  @default(BEGINNER)
  /// Sem `durationMinutes`: a duração do curso é a soma das aulas, derivada na
  /// leitura. Um total digitado à mão desincroniza na primeira aula editada.
  /// Objetivos de aprendizagem (string[]).
  objectives                  Json         @default("[]")
  prerequisites               String?
  mandatory                   Boolean      @default(false)
  certificateEnabled          Boolean      @default(true)
  /// Ciclo de vida do curso (Documento 4, seção 9.6). Era `published Boolean`.
  /// Só `PUBLISHED` aparece para o aluno; os outros quatro são etapas da
  /// autoria. O DTO segue expondo `published`, derivado daqui, porque é o que
  /// as telas do aluno perguntam.
  status                      CourseStatus @default(DRAFT)
  /// Recompensa ao concluir (Documento 4, seção 9.6): 25 pontos e 10 EMR Coins
  /// por padrão, e definida POR CURSO. Não é `CoinRule`: aquela só sabe valor
  /// fixo por evento, e aqui o valor é do curso — mesmo caso do desafio e do
  /// selo, que usam `awardFixedCoins`/`awardFixedXp`. Zero = sem recompensa.
  rewardPoints                Int          @default(25)
  rewardCoins                 Int          @default(10)
  publishedAt                 DateTime?
  /// Setor DONO do curso: quem o administra, e o recorte que o SUBADMIN escreve.
  /// Nulo = da empresa toda. Para "quem ENXERGA", ver `audienceSectors` abaixo —
  /// os dois somam, e este continua sendo um só de propósito, porque autoria tem
  /// um responsável e público tem vários.
  sectorId                    String?
  /// Categorias de cargo que enxergam o curso (Documento 4, seção 9.2). Vazio =
  /// sem restrição por cargo.
  ///
  /// ATENÇÃO OPERACIONAL: curso restrito por cargo fica invisível para quem está
  /// com `positionCategory` vazio — que é todo mundo até a importação rodar com
  /// a coluna nova. Mesma pegadinha do `managerId` e dos painéis da Liderança.
  audiencePositionCategories  String[]     @default([])
  /// Rótulo de recomendação (Todos, Novos colaboradores, Líderes…). NÃO restringe
  /// acesso: um curso recomendado para líderes continua visível para todos.
  recommendedFor              String[]     @default([])
  /// Matricula sozinho quem entra no público-alvo, em lote e de forma idempotente.
  autoEnroll                  Boolean      @default(false)
  /// Curso cuja emissão de certificado passa por fila de aprovação em vez de
  /// sair automaticamente ao concluir.
  requiresCertificateApproval Boolean      @default(false)
  /// Modelo visual usado no certificado emitido deste curso; nulo cai no
  /// isDefault da empresa e, na ausência dele, no visual atual.
  certificateTemplateId       String?
  companyId                   String       @default("company-emr")
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  company             Company                @relation(fields: [companyId], references: [id])
  sector              Sector?                @relation("CourseSector", fields: [sectorId], references: [id], onDelete: SetNull)
  certificateTemplate CertificateTemplate?   @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  modules             CourseModule[]
  lessons             CourseLesson[]
  enrollments         CourseEnrollment[]
  progress            LessonProgress[]
  favorites           CourseFavorite[]
  ratings             CourseRating[]
  certificates        Certificate[]
  trackLinks          LearningTrackCourse[]
  quizzes             CourseQuiz[]
  certificateRequests CertificateRequest[]
  courseCategory      CourseCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  competencyLinks     CourseCompetency[]
  instructorLinks     CourseInstructor[]
  audienceSectors     CourseAudienceSector[]

  @@unique([slug, companyId])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, sectorId])
}

/// Categoria de curso. `parentId` preenchido = subcategoria; nulo = a "categoria
/// raiz" da seção 9.6.
///
/// Slug único POR EMPRESA, como `Badge.slug` e `Sector.slug` — regra do repo para
/// model tenant-scoped. E desativa-se (`active`), nunca se apaga: o slug é o que
/// sobrevive a renomeação, e apagar levaria os cursos junto.
/// Setores que ENXERGAM o curso, além do dono (`Course.sectorId`). Tabela de
/// ligação porque a 9.2 pede "setores específicos", no plural — e porque assim
/// o `where` da visibilidade continua sendo uma consulta, não um filtro em
/// memória.
model CourseAudienceSector {
  courseId String
  sectorId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([courseId, sectorId])
  @@index([sectorId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String
  /// Emoji.
  icon      String?
  parentId  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   CourseCategory?  @relation("CourseCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CourseCategory[] @relation("CourseCategoryTree")
  company  Company          @relation(fields: [companyId], references: [id])
  courses  Course[]

  @@unique([companyId, slug])
  @@index([companyId, active])
}

/// Competência desenvolvida por um curso, usada para recomendar no PDI.
///
/// NÃO é `RecognitionCategory`: aquela é o catálogo de categorias de FEEDBACK da
/// empresa, e `Badge.categorySlug` a referencia. São dois catálogos com o mesmo
/// tipo de nome, e fundi-los faria um curso de "Liderança" contar como categoria
/// de feedback "Liderança", que pode nem existir.
model Competency {
  id          String   @id @default(cuid())
  name        String
  slug        String
  icon        String?
  description String?
  active      Boolean  @default(true)
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  courses CourseCompetency[]

  @@unique([companyId, slug])
  @@index([companyId, active])
}

/// Instrutor de curso. `userId` preenchido = colaborador da EMR, e aí nome, foto
/// e área são DERIVADOS do `User` (seção 9.7) — o cadastro manual fica para quem
/// é de fora. Único por usuário dentro da empresa: o mesmo colaborador não vira
/// dois instrutores.
model Instructor {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String?
  photoUrl  String?
  bio       String?
  expertise String[]
  active    Boolean  @default(true)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?              @relation("InstructorUser", fields: [userId], references: [id], onDelete: SetNull)
  company Company            @relation(fields: [companyId], references: [id])
  courses CourseInstructor[]

  @@unique([companyId, userId])
  @@index([companyId, active])
}

/// N:N curso ⇄ competência. Tabela de ligação, e não array de FK: array não tem
/// integridade referencial nem permite consultar "cursos desta competência".
model CourseCompetency {
  courseId     String
  competencyId String

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([courseId, competencyId])
  @@index([competencyId])
}

/// N:N curso ⇄ instrutor — é o que a 9.7 pede com "mais de um instrutor por
/// treinamento". `sortOrder` decide quem é o principal (o primeiro).
model CourseInstructor {
  courseId     String
  instructorId String
  sortOrder    Int    @default(0)

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([courseId, instructorId])
  @@index([instructorId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company        @relation(fields: [companyId], references: [id])
  lessons CourseLesson[]

  @@index([courseId, sortOrder])
  @@index([companyId])
}

model CourseLesson {
  id              String   @id @default(cuid())
  courseId        String
  moduleId        String
  title           String
  description     String?
  /// Conteúdo da aula: lista ordenada de blocos (Documento 4, seção 9.1).
  /// Substituiu `type`/`videoUrl`/`contentHtml` — a aula deixou de ter um
  /// formato só. O formato hoje é DERIVADO dos blocos (`lessonKindOf`).
  ///
  /// Array em coluna, e não tabela de blocos, porque o que a tabela daria a
  /// mais é consulta por tipo de bloco — e a única que existe é a do quiz, que
  /// segue em `CourseQuiz`, tabela própria. O bloco de quiz guarda só o id.
  contentBlocks   Json     @default("[]")
  durationMinutes Int      @default(0)
  sortOrder       Int      @default(0)
  companyId       String   @default("company-emr")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id])
  progress LessonProgress[]
  quiz     CourseQuiz?

  @@index([moduleId, sortOrder])
  @@index([courseId])
  @@index([companyId])
}

model CourseEnrollment {
  id             String                 @id @default(cuid())
  userId         String
  courseId       String
  status         CourseEnrollmentStatus @default(IN_PROGRESS)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime?
  lastLessonId   String?
  companyId      String                 @default("company-emr")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user    User    @relation("CourseEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  certificateRequest CertificateRequest?

  @@unique([userId, courseId])
  @@index([companyId, userId])
  @@index([courseId])
}

/// Aula concluída. Idempotente por (userId, lessonId) — o progresso do curso é
/// sempre derivado daqui, nunca de um contador solto.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  courseId    String
  completedAt DateTime @default(now())
  companyId   String   @default("company-emr")

  user    User         @relation("LessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id])

  @@unique([userId, lessonId])
  @@index([companyId, userId, courseId])
}

model CourseFavorite {
  userId    String
  courseId  String
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  user    User    @relation("CourseFavorites", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@id([userId, courseId])
  @@index([companyId, userId])
}

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("CourseRatings", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([companyId])
}

model LearningTrack {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverUrl     String?
  category     String
  /// Competências da trilha (string[]).
  competencies Json     @default("[]")
  sortOrder    Int      @default(0)
  published    Boolean  @default(false)
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id])
  courses LearningTrackCourse[]

  @@index([companyId, published, sortOrder])
}

model LearningTrackCourse {
  id        String   @id @default(cuid())
  trackId   String
  courseId  String
  sortOrder Int      @default(0)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  track   LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id])

  @@unique([trackId, courseId])
  @@index([companyId])
}

/// Certificado emitido. `code` é público e verificável sem login (/certificado/:code).
model Certificate {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  courseId  String?
  title     String
  hours     Int
  imageUrl  String?
  issuedAt  DateTime @default(now())
  companyId String   @default("company-emr")

  user    User    @relation("Certificates", fields: [userId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, courseId])
  @@index([companyId, userId])
}

/// Quiz de uma aula ou o quiz final de um curso.
model CourseQuiz {
  id           String   @id @default(cuid())
  courseId     String
  /// Nulo = quiz final do curso; preenchido = quiz daquela aula. O `@unique`
  /// numa coluna nullable aceita vários NULL no Postgres, então garante "uma
  /// aula, no máximo um quiz" sem impedir que cada curso tenha o seu próprio
  /// quiz final. "Um quiz final por curso" NÃO é coberto por este índice —
  /// fica como regra de service, com teste (Task 5).
  lessonId     String?  @unique
  title        String
  passingScore Int      @default(70)
  /// Nulo = tentativas ilimitadas.
  maxAttempts  Int?
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    CourseLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id])
  questions CourseQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([companyId])
}

/// Questão de múltipla escolha de um `CourseQuiz`.
model CourseQuestion {
  id          String   @id @default(cuid())
  quizId      String
  statement   String
  /// `[{ id, text, correct }]`, validado por schema Zod exportado de
  /// `@legends/shared`. O gabarito (`correct`) nunca sai no DTO de quem responde.
  options     Json
  explanation String?
  sortOrder   Int      @default(0)
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz    CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@index([quizId, sortOrder])
  @@index([companyId])
}

/// Tentativa de resposta de um quiz por uma pessoa. `attemptNumber` é derivado
/// das tentativas anteriores no momento da submissão.
model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  attemptNumber Int
  score         Int
  passed        Boolean
  /// Respostas dadas nesta tentativa: `[{ questionId, optionId }]`.
  answers       Json
  companyId     String   @default("company-emr")
  createdAt     DateTime @default(now())

  quiz    CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User       @relation("QuizAttempts", fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@unique([quizId, userId, attemptNumber])
  @@index([companyId, userId])
}

/// Modelo visual de certificado (cores, assinatura, logo). Documento da
/// empresa — CRUD é sempre de ADMIN, nunca de SUBADMIN.
model CertificateTemplate {
  id                String   @id @default(cuid())
  name              String
  title             String
  backgroundUrl     String?
  /// Nulos = herdam a MARCA da empresa (cor institucional e logo do branding).
  /// Antes o certificado tinha identidade própria, mantida à parte; manter
  /// identidade em dois lugares é o que faz o certificado envelhecer enquanto o
  /// resto do portal muda. Preenchidos, continuam mandando — o modelo é a
  /// exceção, a marca é o padrão.
  accentColor       String?
  signatureName     String
  signatureRole     String
  signatureImageUrl String?
  logoUrl           String?
  isDefault         Boolean  @default(false)
  companyId         String   @default("company-emr")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  courses Course[]

  @@index([companyId])
  @@index([companyId, isDefault])
}

/// Solicitação de emissão de certificado para curso com aprovação obrigatória.
/// Idempotente por `enrollmentId`: uma inscrição gera no máximo uma solicitação
/// viva por vez; recusar guarda o motivo e permite nova solicitação depois.
model CertificateRequest {
  id              String                   @id @default(cuid())
  origin          CertificateRequestOrigin @default(INTERNAL)
  userId          String
  /// Nulos no externo: certificado de fora não tem matrícula nem curso no
  /// portal. O `@unique` sobrevive porque no Postgres nulo não colide com nulo,
  /// então continua valendo "uma matrícula, no máximo um pedido".
  enrollmentId    String?                  @unique
  courseId        String?
  status          CertificateRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  /// --- Só no externo (Documento 4, seção 9.8) ---
  /// O formulário do Notion pergunta nome e setor; aqui não, porque o portal já
  /// sabe os dois pelo usuário logado.
  externalCourseName  String?
  trainingType        TrainingType?
  sponsor             TrainingSponsor?
  /// Texto livre do "Outro" no patrocinador — opcional, como o formulário pede.
  sponsorOther        String?
  /// Em CENTAVOS: dinheiro em ponto flutuante acumula erro de arredondamento.
  investedAmountCents Int?
  /// "Por que você realizou esse curso?" — o formulário permite até dois.
  reasons             TrainingReason[] @default([])
  /// Data da solicitação ao gestor; só faz sentido com `SOLICITACAO_GESTOR`.
  requestedAt         DateTime?
  /// Chave do anexo no S3 (o certificado em si). Chave, e não URL: o documento é
  /// pessoal, e a leitura sai assinada e temporária no serialize.
  attachmentKey       String?

  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment CourseEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User              @relation("CertificateRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  course     Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("CertificateRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  company    Company           @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([courseId])
  /// A fila do externo é lida por empresa + origem; sem isto ela varre a tabela.
  @@index([companyId, origin, status])
}

/// Evento interno de treinamento: o molde de onde nascem várias participações
/// de uma vez (`TrainingRecord`), em vez de o T&D digitar a mesma palestra
/// oitenta vezes. Ver `docs/superpowers/specs/2026-09-12-modulo-de-treinamentos-td-design.md`.
model TrainingEvent {
  id          String  @id @default(cuid())
  companyId   String  @default("company-emr")
  name        String
  description String?

  learningType String    @default("Evento")
  modality     String?
  /// Data civil: o evento é de um dia, não de um instante.
  eventDate    DateTime? @db.Date
  hours        Decimal   @default(0) @db.Decimal(6, 2)
  institution  String?

  trainingType           TrainingType?
  reasons                TrainingReason[] @default([])
  priority               String           @default("Média")
  /// Em CENTAVOS. Pode ser rateado entre os participantes no cadastro em massa.
  defaultInvestmentCents Int              @default(0)
  status                 String           @default("Planejado")

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id])
  createdBy User?            @relation("TrainingEventsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  records   TrainingRecord[]

  @@index([companyId, eventDate])
}

/// O registro de treinamento — o fato único do módulo de T&D.
///
/// Substitui o `CertificateRequest` de origem EXTERNAL, que era isto sem carga
/// horária, instituição nem data de conclusão (a migration fez o backfill). Os
/// campos de identificação são SNAPSHOT do momento da escrita: quem muda de
/// setor não leva o treinamento antigo para o setor novo.
model TrainingRecord {
  id        String  @id @default(cuid())
  companyId String  @default("company-emr")
  userId    String
  eventId   String?

  /// --- Snapshot de quem fez ---
  userName         String
  sectorName       String?
  squad            String?
  leaderName       String?
  position         String?
  positionCategory String?
  employmentType   String?

  courseTitle  String
  learningType String        @default("Curso")
  modality     String?
  trainingType TrainingType?
  hours        Decimal       @default(0) @db.Decimal(6, 2)
  institution  String?

  sponsor         TrainingSponsor  @default(GRATUITO)
  sponsorOther    String?
  /// Em CENTAVOS: dinheiro em ponto flutuante acumula erro de arredondamento.
  investmentCents Int              @default(0)
  reasons         TrainingReason[] @default([])
  priority        String           @default("Média")

  /// Quando a demanda nasceu e quando a ação terminou — datas civis, porque o
  /// SLA conta dias, não horas.
  requestDate    DateTime  @db.Date
  completionDate DateTime? @db.Date

  participationStatus String  @default("Participou")
  source              String  @default("Autoatendimento do colaborador")
  notes               String?
  /// Chave do comprovante no S3. Chave, e não URL: o documento é pessoal, e a
  /// leitura sai assinada e temporária no serialize.
  attachmentKey       String?

  validationStatus TrainingValidationStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  user       User           @relation("TrainingRecords", fields: [userId], references: [id], onDelete: Cascade)
  event      TrainingEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reviewedBy User?          @relation("TrainingRecordsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("TrainingRecordsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, completionDate])
  @@index([companyId, validationStatus])
  @@index([userId])
  @@index([eventId])
}

/// Plano de desenvolvimento de uma pessoa num ciclo (ex.: 2026-Q1).
model PdiPlan {
  id          String        @id @default(cuid())
  userId      String
  leaderId    String?
  title       String
  status      PdiPlanStatus @default(DRAFT)
  cyclePeriod String?
  startsAt    DateTime?
  endsAt      DateTime?
  companyId   String        @default("company-emr")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User        @relation("PdiPlans", fields: [userId], references: [id], onDelete: Cascade)
  leader  User?       @relation("PdiPlansLed", fields: [leaderId], references: [id])
  company Company     @relation(fields: [companyId], references: [id])
  actions PdiAction[]

  @@index([companyId, userId])
  @@index([companyId, leaderId])
}

model PdiAction {
  id                   String            @id @default(cuid())
  planId               String
  description          String
  type                 PdiActionType     @default(OTHER)
  priority             PdiActionPriority @default(MEDIUM)
  status               PdiActionStatus   @default(NOT_STARTED)
  dueDate              DateTime?
  /// Progresso informado pela pessoa (0–100) — não é derivado, diferente do curso.
  progressPct          Int               @default(0)
  competency           String?
  notes                String?           @db.Text
  /// Itens do checklist ({ id, text, done }[]).
  checklist            Json              @default("[]")
  /// Respostas da reflexão guiada; preenchida na conclusão.
  reflection           Json?
  practicalApplication String?           @db.Text
  startedAt            DateTime?
  completedAt          DateTime?
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewComment        String?           @db.Text
  sharedAt             DateTime?
  companyId            String            @default("company-emr")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  plan       PdiPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("PdiActionsReviewed", fields: [reviewedById], references: [id])
  company    Company             @relation(fields: [companyId], references: [id])
  evidences  PdiActionEvidence[]
  history    PdiActionHistory[]

  promotedFromOneOnOne OneOnOneAction? @relation("OneOnOnePromotedAction")

  @@index([planId])
  @@index([companyId, status])
}

model PdiActionEvidence {
  id           String          @id @default(cuid())
  actionId     String
  kind         PdiEvidenceKind
  /// Chave do objeto no storage — nunca a URL (o download passa por rota assinada).
  storageKey   String?
  fileName     String?
  mimeType     String?
  externalUrl  String?
  uploadedById String
  companyId    String          @default("company-emr")
  createdAt    DateTime        @default(now())

  action     PdiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("PdiEvidencesUploaded", fields: [uploadedById], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([actionId])
  @@index([companyId])
}

model PdiActionHistory {
  id        String             @id @default(cuid())
  actionId  String
  eventType PdiActionEventType
  actorId   String?
  metadata  Json               @default("{}")
  companyId String             @default("company-emr")
  createdAt DateTime           @default(now())

  action  PdiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actor   User?     @relation("PdiActionEvents", fields: [actorId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@index([actionId, createdAt])
  @@index([companyId])
}

/// Painel externo de BI embutido na administração. `sectorId` null = painel da
/// empresa inteira. A FK de setor é Cascade de propósito: com SetNull, apagar um
/// setor promoveria seus painéis a painéis da empresa e exporia dado de RH do
/// setor para toda a administração.
model HrDashboard {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String
  height      Int      @default(720)
  sortOrder   Int      @default(0)
  sectorId    String?
  companyId   String   @default("company-emr")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, sectorId, sortOrder])
}

/// Agentes de IA disponíveis. O par AgentConversation/AgentMessage é genérico de
/// propósito — o que muda entre agentes é o system prompt e a fonte de contexto,
/// não o armazenamento. `GLASS` já existe aqui para o PBI #22282 reaproveitar a
/// mesma tabela em vez de clonar uma estrutura quase igual.
enum AgentKind {
  BENCHMARK
  GLASS
  ASSISTANT
  INOVA
  APPRENTICE
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum GlassSentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

/// Avaliação externa (Glassdoor) colada por um administrador. Anônima por
/// construção: `createdById` é quem COLOU o texto, nunca quem o escreveu — não
/// existe coluna de autoria, e o prompt de extração é instruído a descartar
/// qualquer traço identificador que apareça no texto.
///
/// `status` e `tenure` seguem `String` (validados contra a lista fechada de
/// `@legends/shared` na escrita): o Glassdoor pode introduzir uma faixa nova, e
/// isso não deve exigir migration.
model GlassReview {
  id                 String          @id @default(cuid())
  companyId          String
  reviewDate         DateTime?
  /// Nota é 1,0 a 5,0. Decimal, não Float: média de RH em ponto flutuante vira
  /// 4.199999999999999 na tela.
  rating             Decimal?        @db.Decimal(2, 1)
  role               String?
  level              String?
  sector             String?
  tenure             String?
  status             String?
  recommends         Boolean?
  leadershipApproval Boolean?
  title              String?
  positives          String?
  negatives          String?
  advice             String?
  sentiment          GlassSentiment?
  themesPositive     String[]
  themesNegative     String[]
  /// Só os alertas POR AVALIAÇÃO. Os agregados (queda consecutiva, setor
  /// crítico) dependem das vizinhas e mudariam retroativamente a cada nova
  /// avaliação — são calculados na leitura, em `glass-overview-service`.
  alerts             String[]
  aiSummary          String?
  /// Fica null quando quem colou sai da base — a avaliação sobrevive à pessoa.
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("GlassReviewsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, reviewDate])
  @@index([companyId, sector])
}

/// Inventário de práticas internas de cultura — a base de comparação que o
/// agente de Benchmarking recebe como contexto. É da empresa inteira, sem
/// recorte por setor: ação de endomarketing não pertence a um setor.
model BenchmarkPractice {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  title       String
  description String?
  /// Canal de divulgação: LinkedIn, Teams, Notion…
  channel     String?
  tags        String[]
  /// Fica null quando quem cadastrou sai da base — a prática sobrevive à pessoa.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("BenchmarkPracticesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

/// Conversa com um agente. Sempre **da pessoa**: não existe conversa
/// compartilhada entre dois admins da mesma empresa.
model AgentConversation {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  agent     AgentKind
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  user     User           @relation("AgentConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([companyId, userId, agent, updatedAt])
}

model AgentMessage {
  id             String           @id @default(cuid())
  companyId      String
  conversationId String
  role           AgentMessageRole
  content        String
  createdAt      DateTime         @default(now())

  company      Company           @relation(fields: [companyId], references: [id])
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChallengeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Desafio proposto pela empresa ou por um setor. A recompensa é por desafio —
/// não passa por CoinRule, que só sabe valor fixo por evento.
model Challenge {
  id              String    @id @default(cuid())
  title           String
  description     String
  /// Coins creditados na aprovação. <= 0 não gera lançamento no extrato.
  rewardCoins     Int
  /// Chave manual de publicação. Nome com `is` de propósito: booleano chamado
  /// `active`/`status` não diz no call site *ativo o quê*.
  isActive        Boolean   @default(true)
  /// Uma de CHALLENGE_CATEGORIES (@legends/shared). String e não enum do Prisma:
  /// categoria é catálogo de produto, não invariante do banco — incluir uma não
  /// deve custar migration. O default existe só para a migration desta coluna;
  /// a API sempre exige categoria explícita.
  category        String    @default("Engajamento")
  /// Corpo longo em Markdown, renderizado por components/Markdown.tsx.
  /// NUNCA HTML: nada de markup vindo do banco chega ao DOM.
  detailsMarkdown String?
  /// Chave do S3 da imagem de capa. Guarda-se a chave, nunca a URL.
  imageKey        String?
  /// Ordem na vitrine; menor primeiro.
  position        Int       @default(0)
  /// Participação precisa passar pela fila de moderação. Persistido e exposto
  /// aqui; quem consome é o PBI "Resultados de Desafios".
  requiresReview  Boolean   @default(true)
  /// Não listado: some da vitrine, mas o detalhe continua servindo para quem
  /// está no escopo, de modo que um link compartilhado funciona.
  isPrivate       Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  /// Janela opcional; null dos dois lados = aberto enquanto `isActive`.
  startsAt        DateTime?
  endsAt          DateTime?
  /// null = desafio da empresa inteira (só ADMIN cria e modera).
  sectorId        String?
  companyId       String    @default("company-emr")
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sector      Sector?               @relation(fields: [sectorId], references: [id])
  company     Company               @relation(fields: [companyId], references: [id])
  createdBy   User                  @relation("ChallengesCreated", fields: [createdById], references: [id])
  submissions ChallengeSubmission[]

  @@index([companyId, isActive, position])
  @@index([companyId, sectorId])
}

model ChallengeSubmission {
  id              String                    @id @default(cuid())
  challengeId     String
  userId          String
  status          ChallengeSubmissionStatus @default(PENDING)
  note            String?
  /// Chave S3 da evidência opcional; o DTO expõe URL assinada, nunca a chave.
  evidenceKey     String?
  submittedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  companyId       String                    @default("company-emr")

  challenge  Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User      @relation("ChallengeSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ChallengeSubmissionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  company    Company   @relation(fields: [companyId], references: [id])

  /// Uma submissão ativa por (desafio, pessoa) é garantida por um índice único
  /// PARCIAL que vive só no SQL da migration (WHERE status <> 'REJECTED') — o
  /// Prisma não sabe representar índice parcial, e declará-lo aqui faria todo
  /// `migrate dev` futuro propor recriá-lo sem o WHERE. Violação chega como P2002.
  @@index([companyId, status, submittedAt])
  @@index([challengeId])
  @@index([userId])
}

/// Item do catálogo da loja. Do escopo da EMPRESA, não do setor: quem administra
/// é o bloco de Gente e Gestão (requireSectorFeature('gente-gestao')), e por isso
/// não há sectorId aqui.
model StoreProduct {
  id           String   @id @default(cuid())
  title        String
  description  String?
  /// Uma de STORE_PRODUCT_CATEGORIES (@legends/shared). String e não enum do Prisma,
  /// mesmo racional de Challenge.category: categoria é catálogo de produto, não
  /// invariante do banco — incluir uma não deve custar migration.
  category     String
  priceInCoins Int
  stock        Int      @default(0)
  /// Chave do S3 da capa. Guarda-se a CHAVE, nunca a URL.
  imageKey     String?
  isDigital    Boolean  @default(false)
  isActive     Boolean  @default(true)
  companyId    String   @default("company-emr")
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  createdBy User         @relation("StoreProductsCreated", fields: [createdById], references: [id])
  orders    StoreOrder[]

  @@index([companyId, isActive, category])
  @@index([companyId])
}

/// Pedido de resgate. `productTitle` e `pricePaid` são CONGELADOS no resgate: o
/// produto muda de nome e de preço depois, e o pedido é histórico.
model StoreOrder {
  id           String           @id @default(cuid())
  userId       String
  /// SetNull, e por isso opcional: apagar um produto não pode apagar o histórico de
  /// quem já resgatou. Cancelar pedido de produto apagado estorna os coins e pula a
  /// devolução de estoque — não há para onde devolver.
  productId    String?
  productTitle String
  pricePaid    Int
  status       StoreOrderStatus @default(PENDING)
  /// Nota INTERNA da G&G. Nunca sai no DTO do colaborador.
  adminNotes   String?
  handledById  String?
  handledAt    DateTime?
  companyId    String           @default("company-emr")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user      User          @relation("StoreOrders", fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  handledBy User?         @relation("StoreOrdersHandled", fields: [handledById], references: [id], onDelete: SetNull)
  company   Company       @relation(fields: [companyId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([productId])
}

/// Base de conhecimento curada por Gente e Gestão. `sectorId` null = vale para a
/// empresa inteira. A FK de setor é Cascade de propósito: com SetNull, apagar um
/// setor promoveria suas entradas a entradas da empresa e exporia resposta de RH
/// do setor para toda a companhia (mesma razão do HrDashboard).
model KnowledgeEntry {
  id          String   @id @default(cuid())
  category    String?
  question    String
  answer      String
  keywords    String[]
  isActive    Boolean  @default(true)
  sectorId    String?
  companyId   String   @default("company-emr")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdBy User    @relation("KnowledgeEntryAuthor", fields: [createdById], references: [id])

  @@index([companyId, isActive])
  @@index([companyId, sectorId])
}

/// Toda pergunta feita à assistente, com o que foi respondido e quais entradas
/// casaram. `matchedEntryIds` vazio marca uma lacuna da base.
model AssistantQuery {
  id              String   @id @default(cuid())
  userId          String
  question        String
  answer          String?
  matchedEntryIds String[]
  companyId       String   @default("company-emr")
  createdAt       DateTime @default(now())

  company  Company            @relation(fields: [companyId], references: [id])
  user     User               @relation("AssistantQueryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  feedback AssistantFeedback?

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

/// Um feedback por pergunta (reclicar atualiza). `rating` é -1 ou 1, validado no Zod.
model AssistantFeedback {
  id        String   @id @default(cuid())
  queryId   String   @unique
  userId    String
  rating    Int
  comment   String?
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  query   AssistantQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user    User           @relation("AssistantFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, rating])
}

enum CampaignAudience {
  ALL
  LEADERSHIP
}

enum CampaignChannel {
  MURAL
  TEAMS
  EMAIL
}

enum CampaignPostStatus {
  SCHEDULED
  PUBLISHED
  CANCELLED
}

/// Campanha de comunicação: o guarda-chuva editorial (tema + janela) sob o qual
/// nascem N comunicados agendados.
model Campaign {
  id          String           @id @default(cuid())
  theme       String
  startsAt    DateTime
  endsAt      DateTime
  audience    CampaignAudience
  notes       String?
  /// Fica null quando quem criou sai da base — a campanha sobrevive à pessoa
  /// (mesmo precedente de `BenchmarkPractice.createdById`).
  createdById String?
  companyId   String
  createdAt   DateTime         @default(now())

  createdBy User?          @relation("CampaignsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  company   Company        @relation(fields: [companyId], references: [id])
  posts     CampaignPost[]

  @@index([companyId, createdAt])
}

/// Item do calendário editorial. `campaignId` é opcional de propósito: é o que
/// permite criar item na mão quando a IA está indisponível.
model CampaignPost {
  id              String             @id @default(cuid())
  campaignId      String?
  title           String
  body            String
  visualHint      String?
  /// Arte do comunicado, que viaja para o post do Mural na publicação. Não é o
  /// mesmo que `visualHint`: aquele é o briefing em texto ("Imagem do MKT."),
  /// este é a peça pronta. Guardado como URL do S3 + dimensões, no mesmo molde
  /// de `CorporatePost.imageUrl` — é para lá que ele vai.
  imageUrl        String?
  imageWidth      Int?
  imageHeight     Int?
  /// Quem agendou o item. Existe por causa da publicação automática: o tick não
  /// tem usuário logado, e o post do Mural precisa de autor com permissão de
  /// publicar direto. `Campaign.createdById` não basta — item avulso não tem
  /// campanha. Nulo só nas linhas anteriores à coluna que também não tinham
  /// campanha para o backfill: essas continuam saindo pelo "Publicar agora".
  createdById     String?
  scheduledFor    DateTime
  channel         CampaignChannel
  audience        CampaignAudience
  status          CampaignPostStatus @default(SCHEDULED)
  responsibleId   String?
  publishedPostId String?            @unique
  publishedAt     DateTime?
  companyId       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  responsible   User?          @relation("CampaignPostsResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("CampaignPostsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// SetNull mantido pela ponta do banco, mas ELE SOZINHO não basta: com a linha
  /// preservada, apagar o comunicado deixava um item `PUBLISHED` sem post no
  /// calendário editorial, apontando para nada (Documento 4, seção 13.2). Quem
  /// apaga o item junto é `deletePost`, em `corporate-mural-service.ts` — leia
  /// o comentário de lá antes de mexer aqui.
  publishedPost CorporatePost? @relation(fields: [publishedPostId], references: [id], onDelete: SetNull)
  company       Company        @relation(fields: [companyId], references: [id])

  @@index([companyId, scheduledFor])
  @@index([companyId, status])
  /// O tick da publicação automática varre exatamente por aqui.
  @@index([status, channel, scheduledFor])
}

/// Álbum de fotos de um evento da empresa (confraternização, hackathon, onboarding).
model EventAlbum {
  id              String             @id @default(cuid())
  title           String
  description     String?
  eventDate       DateTime?
  /// Capa: FK para uma foto do próprio álbum. SetNull para que apagar a foto-capa
  /// não deixe o álbum apontando para objeto inexistente — a grade cai no fallback.
  coverPhotoId    String?            @unique
  /// Capa enviada no formulário, independente das fotos do álbum. Guarda a CHAVE
  /// do S3, como EventPhoto.storageKey. Tem precedência sobre `coverPhotoId`:
  /// quem subiu uma capa escolheu essa imagem de propósito.
  coverStorageKey String?
  /// Enquadramento da capa, aplicado igual no editor e na grade.
  coverFit        EventAlbumCoverFit @default(COVER)
  /// Posição vertical do recorte, 0 (topo) a 100 (base).
  coverPositionY  Int                @default(50)
  /// Zoom em porcentagem; 100 é a imagem sem ampliação.
  coverScale      Int                @default(100)
  createdById     String
  companyId       String             @default("company-emr")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  cover     EventPhoto?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos    EventPhoto[] @relation("AlbumPhotos")
  createdBy User         @relation("EventAlbumsCreated", fields: [createdById], references: [id])
  company   Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, eventDate])
}

/// Como a capa preenche o quadro do card: COVER corta o que sobra, CONTAIN cabe
/// inteira. Espelha `EVENT_ALBUM_COVER_FITS` no contrato compartilhado.
enum EventAlbumCoverFit {
  COVER
  CONTAIN
}

/// Foto de um álbum. Guarda a CHAVE do objeto no S3, nunca a URL — URL assinada
/// expira e URL pública gravada engessa o bucket. O serialize resolve a pública.
model EventPhoto {
  id           String   @id @default(cuid())
  albumId      String
  storageKey   String
  width        Int?
  height       Int?
  uploadedById String
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())

  album      EventAlbum           @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
  coverOf    EventAlbum?          @relation("AlbumCover")
  uploadedBy User                 @relation("EventPhotosUploaded", fields: [uploadedById], references: [id])
  company    Company              @relation(fields: [companyId], references: [id])
  reactions  EventPhotoReaction[]
  comments   EventPhotoComment[]

  @@index([albumId, createdAt])
  @@index([companyId])
}

model EventPhotoReaction {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  photo   EventPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user    User       @relation("EventPhotoReactions", fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@unique([photoId, userId, emoji])
  @@index([photoId])
  @@index([companyId])
}

model EventPhotoComment {
  id        String   @id @default(cuid())
  photoId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  photo   EventPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author  User       @relation("EventPhotoComments", fields: [authorId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@index([photoId, createdAt])
  @@index([companyId])
}

/// Periodicidade de um evento de calendário cadastrado.
enum CalendarRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

///
/// Tipo de evento de calendário — "Provas B2B", "Comunicados", "Treinamentos".
/// É dado, não enum: cada empresa cadastra os seus, e o calendário desenha um
/// chip de filtro por tipo. Enum aqui custaria migration a cada tipo novo.
model CalendarEventType {
  id        String   @id @default(cuid())
  name      String
  slug      String
  icon      String   @default("event")
  /// Cor da categoria em hex. É o padrão aplicado sozinho ao evento no cadastro;
  /// o catálogo é por empresa, então a cor mora aqui e não num mapa fixo no front.
  color     String   @default("#6366f1")
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  events  CalendarEvent[]

  @@unique([companyId, slug])
  @@index([companyId])
}

///
/// Evento datado cadastrado pela empresa. `date` é a data civil da primeira (ou
/// única) ocorrência; as demais saem da regra de recorrência, expandidas na
/// leitura por `expandOccurrences` (@legends/shared) — nunca materializadas.
model CalendarEvent {
  id                 String             @id @default(cuid())
  title              String
  description        String             @default("")
  /// Rótulo fino do evento ("Simulado", "Circuito", "Café Temático") — a coluna
  /// `Tag` da planilha da G&G. Descreve com a granularidade do negócio, mas NÃO
  /// dá cor nem entra no filtro: isso é da categoria (`typeId`). Sem ele, cada
  /// vocabulário novo da planilha viraria uma categoria, e a barra de filtro
  /// cresceria sem dono.
  tag                String?
  date               DateTime           @db.Date
  /// Último dia do evento; null quando ele cabe num dia só. A duração em dias
  /// acompanha cada ocorrência da recorrência, não só a primeira.
  endDate            DateTime?          @db.Date
  /// HH:MM local; null é evento de dia inteiro — e é o que joga a marcação para
  /// a faixa "DIA TODO" no topo da grade, em vez de uma faixa de horário.
  startTime          String?
  /// HH:MM local do fim. Sem `startTime` não significa nada.
  endTime            String?
  typeId             String
  /// Cor em hex sobrescrevendo a da categoria. Null é o caso normal.
  color              String?
  /// Público-alvo por tag, do mesmo vocabulário da planilha de colaboradores.
  /// **Vazio (ou contendo "Todos") é a empresa inteira** — e não "ninguém",
  /// mesma convenção de `CalendarEventSector`. As duas regras se somam.
  audienceTags       String[]           @default([])
  /// Ação de Comunicação Interna: registro da G&G que não vai para a empresa.
  /// Some da API para quem não é admin nem do time de Gente e Gestão.
  isInternalComm     Boolean            @default(false)
  recurrence         CalendarRecurrence @default(NONE)
  recurrenceUntil    DateTime?          @db.Date
  recurrenceCount    Int?
  /// Antecedências do lembrete em dias. Vazio = sem lembrete.
  reminderDaysBefore Int[]              @default([])
  createdById        String
  companyId          String             @default("company-emr")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  type      CalendarEventType           @relation(fields: [typeId], references: [id])
  createdBy User                        @relation("CalendarEventsCreated", fields: [createdById], references: [id])
  company   Company                     @relation(fields: [companyId], references: [id])
  sectors   CalendarEventSector[]
  guests    CalendarEventGuest[]
  reminders CalendarEventReminderSent[]

  @@index([companyId, date])
  @@index([typeId])
}

///
/// Público-alvo do evento. **Nenhuma linha significa empresa inteira** — e não
/// "ninguém". Marcar todos os setores no cadastro congelaria o público: setor
/// criado depois ficaria de fora de um evento que era de todo mundo.
/// Pessoa convidada nominalmente para um evento (Documento 3, seção 11).
///
/// O convidado enxerga o evento **independentemente de setor e de tag** — é o
/// ponto todo do convite nominal: chamar quem o recorte por setor não alcança.
/// As duas regras antigas continuam valendo e se somam a esta.
///
/// Tabela, e não um `String[]` de ids no evento: convidado é relação com gente.
/// Um array de texto não tem FK — pessoa excluída deixaria id órfão, e não
/// haveria como perguntar "em que eventos fulano foi convidado" sem varrer tudo.
model CalendarEventGuest {
  eventId   String
  userId    String
  companyId String @default("company-emr")

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation("CalendarEventGuests", fields: [userId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id])

  @@id([eventId, userId])
  @@index([userId])
  @@index([companyId])
}

model CalendarEventSector {
  eventId  String
  sectorId String

  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sector Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([eventId, sectorId])
  @@index([sectorId])
}

///
/// Reivindicação de um lembrete já disparado. A unique é o que impede lembrete
/// duplicado: o INSERT é a reivindicação, e violação (P2002) significa que outro
/// tick — ou outro processo — chegou primeiro.
///
/// A granularidade é (evento, ocorrência, antecedência), não o evento: evento
/// recorrente com duas antecedências tem várias linhas legítimas, e uma flag
/// única no evento responderia à pergunta errada.
model CalendarEventReminderSent {
  id             String   @id @default(cuid())
  eventId        String
  occurrenceDate DateTime @db.Date
  daysBefore     Int
  sentAt         DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate, daysBefore])
  @@index([eventId])
}

enum OneOnOneRecurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OneOnOneMeetingStatus {
  SCHEDULED
  DONE
  CANCELED
}

/// Resposta do CONVIDADO ao convite de 1:1 — de uma pessoa, não do encontro.
/// Não entra no `OneOnOneMeetingStatus` de propósito: aquele é o estado do
/// encontro para os dois, e misturar criaria estados sem sentido
/// ("recusado e realizado").
enum OneOnOneInviteResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum OneOnOneActionStatus {
  OPEN
  DONE
  PROMOTED
}

enum OneOnOneTopicOrigin {
  TEMPLATE
  CUSTOM
}

/// O par e o ritmo do 1:1. `userAId`/`userBId` são guardados ORDENADOS pelo id
/// (ver `normalizeOneOnOnePair` em @legends/shared): é o que torna "as ações
/// abertas deste par" uma consulta direta, e não um OR das duas combinações.
model OneOnOneSeries {
  id                 String                 @id @default(cuid())
  userAId            String
  userBId            String
  createdById        String
  recurrence         OneOnOneRecurrence     @default(NONE)
  recurrenceUntil    DateTime?
  durationMinutes    Int                    @default(30)
  endedAt            DateTime?
  /// A resposta do convidado que vale para a série inteira. A ocorrência só
  /// sobrescreve quando a pessoa disse algo diferente para aquele encontro
  /// (`OneOnOneMeeting.inviteeResponse`) — é o que impede uma série semanal de
  /// virar 52 pendências.
  inviteeResponse    OneOnOneInviteResponse @default(PENDING)
  inviteeRespondedAt DateTime?
  companyId          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  userA     User              @relation("OneOnOneUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User              @relation("OneOnOneUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdBy User              @relation("OneOnOneCreated", fields: [createdById], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])
  meetings  OneOnOneMeeting[]
  actions   OneOnOneAction[]

  @@index([companyId, userAId, userBId])
  @@index([companyId, userBId])
}

/// Uma ocorrência. MATERIALIZADA (diferente de CalendarEvent, cuja recorrência é
/// expandida em consulta): cada encontro carrega pauta, nota e ações próprias e
/// precisa de id estável para ser alvo de FK.
model OneOnOneMeeting {
  id                 String                  @id @default(cuid())
  seriesId           String
  startsAt           DateTime
  endsAt             DateTime
  status             OneOnOneMeetingStatus   @default(SCHEDULED)
  companyId          String
  /// Quando o lembrete de 10 minutos foi reivindicado. É o que impede lembrete
  /// duplicado: o UPDATE ... WHERE remindedAt IS NULL é atômico (ver
  /// `scheduler/one-on-one-reminders.ts`). Remarcar zera o campo — horário novo,
  /// lembrete novo.
  remindedAt         DateTime?
  /// Exceção da série: `null` significa "segue a resposta da série". Só é
  /// preenchido quando o convidado responde diferente para ESTA ocorrência.
  inviteeResponse    OneOnOneInviteResponse?
  inviteeRespondedAt DateTime?
  /// Contraproposta de horário do convidado, e o motivo da recusa. Sempre da
  /// ocorrência, mesmo quando a recusa vale para a série: o que se propõe é um
  /// horário concreto, e horário é de um encontro.
  proposedStartsAt   DateTime?
  declineNote        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  series  OneOnOneSeries        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  company Company               @relation(fields: [companyId], references: [id])
  topics  OneOnOneTopic[]
  notes   OneOnOnePrivateNote[]
  actions OneOnOneAction[]      @relation("OneOnOneActionCreatedIn")

  @@index([seriesId, startsAt])
  @@index([companyId, startsAt])
}

/// Item de pauta. O texto vindo do catálogo é COPIADO, não referenciado por FK:
/// o catálogo muda, a pauta de um encontro passado é registro histórico.
model OneOnOneTopic {
  id          String              @id @default(cuid())
  meetingId   String
  text        String
  origin      OneOnOneTopicOrigin @default(CUSTOM)
  discussed   Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdById String
  companyId   String
  createdAt   DateTime            @default(now())

  meeting   OneOnOneMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User            @relation("OneOnOneTopicsCreated", fields: [createdById], references: [id])
  company   Company         @relation(fields: [companyId], references: [id])

  @@index([meetingId, sortOrder])
  @@index([companyId])
}

/// A observação privada. Uma por pessoa por encontro. NUNCA sai da API para o
/// outro participante — a consulta filtra por authorId, não a tela.
model OneOnOnePrivateNote {
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  body      String   @db.Text
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting OneOnOneMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User            @relation("OneOnOneNotes", fields: [authorId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id])

  @@unique([meetingId, authorId])
  @@index([companyId])
}

/// O combinado. Preso à SÉRIE (logo, ao par): aparece em todo encontro do par
/// até fechar. `promotedPdiActionId` guarda a PdiAction que nasceu dele.
model OneOnOneAction {
  id                  String               @id @default(cuid())
  seriesId            String
  createdInMeetingId  String
  description         String
  ownerId             String
  dueDate             DateTime?
  status              OneOnOneActionStatus @default(OPEN)
  completedById       String?
  completedAt         DateTime?
  promotedPdiActionId String?              @unique
  companyId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  series            OneOnOneSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdInMeeting  OneOnOneMeeting @relation("OneOnOneActionCreatedIn", fields: [createdInMeetingId], references: [id], onDelete: Cascade)
  owner             User            @relation("OneOnOneActionsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  completedBy       User?           @relation("OneOnOneActionsCompleted", fields: [completedById], references: [id])
  promotedPdiAction PdiAction?      @relation("OneOnOnePromotedAction", fields: [promotedPdiActionId], references: [id], onDelete: SetNull)
  company           Company         @relation(fields: [companyId], references: [id])

  @@index([seriesId, status])
  @@index([companyId, ownerId, status])
}

/// Catálogo de tópicos sugeridos, cadastrado em Administração › Gente e Gestão.
model OneOnOneTopicTemplate {
  id        String   @id @default(cuid())
  theme     String
  text      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, active, sortOrder])
}

/// Programação anual de férias — a campanha de um ano.
/// Spec: docs/superpowers/specs/2026-08-25-programacao-anual-de-ferias-design.md
model VacationCampaign {
  id             String   @id @default(cuid())
  year           Int
  opensAt        DateTime @db.Date
  /// Último dia em que os gestores podem preencher.
  deadline       DateTime @db.Date
  /// Bloqueio imediato, independente do prazo.
  manuallyLocked Boolean  @default(false)
  /// A regra vigente, CONGELADA nesta campanha. Se morasse só na empresa,
  /// reabrir 2027 daqui a dois anos revalidaria os planos com a regra de 2029
  /// e acusaria erro em quem seguiu a regra certa.
  policy         Json
  /// Texto do aviso disparado ao colaborador quando o plano é validado.
  noticeTemplate String   @default("")
  companyId      String   @default("company-emr")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id])
  plans   VacationPlan[]

  @@unique([companyId, year])
  @@index([companyId])
}

/// O direito de uma pessoa a um período aquisitivo: quanto tem e até quando
/// pode gozar. Derivado da data-base (`User.vacationAnchorDate` ou a admissão);
/// o saldo e as exceções vêm da folha.
model VacationEntitlement {
  id               String   @id @default(cuid())
  userId           String
  acquisitionStart DateTime @db.Date
  acquisitionEnd   DateTime @db.Date
  /// Data em que as férias precisam TERMINAR (concessivo menos a margem).
  dueDate          DateTime @db.Date
  balanceDays      Int      @default(30)
  /// Observação do DP mostrada ao gestor ("Programação conforme CIEE").
  note             String?
  companyId        String   @default("company-emr")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User             @relation("VacationEntitlements", fields: [userId], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [companyId], references: [id])
  plans   VacationPlan[]
  request VacationRequest?

  @@unique([companyId, userId, acquisitionEnd])
  @@index([companyId, dueDate])
  @@index([userId])
}

/// Regime de contratação, para efeito de férias. NÃO confundir com
/// `THIRD_PARTY`, que é acesso restrito por allowlist: o PJ é membro pleno do
/// time, com contrato diferente.
enum EmploymentType {
  CLT
  PJ
}

enum VacationPlanStatus {
  DRAFT
  CONFIRMED
  /// Conferido pela G&G. É aqui que o aviso sai e que o plano vira `Vacation`:
  /// até então é plano, e o calendário não mostra plano como se fosse fato.
  VALIDATED
}

/// O que o colaborador PEDIU, antes de o gestor programar.
///
/// Pedido, não promessa: quem decide é o gestor, que precisa cobrir a área — foi
/// como a própria G&G descreveu o processo. Existir aqui é o que tira a pessoa
/// da posição de descobrir as próprias férias por e-mail, depois de decididas.
model VacationRequest {
  id            String   @id @default(cuid())
  entitlementId String   @unique
  /// As datas desejadas, em JSON — e aqui isso é certo, ao contrário do plano:
  /// um pedido nunca é consultado entre pessoas, só lido junto do próprio
  /// direito. Não há "quem pediu julho?" que justifique linha.
  periods       Json     @default("[]")
  note          String?
  companyId     String   @default("company-emr")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entitlement VacationEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model VacationPlan {
  id              String             @id @default(cuid())
  campaignId      String
  entitlementId   String
  sellDays        Boolean            @default(false)
  note            String?
  status          VacationPlanStatus @default(DRAFT)
  /// O gestor recusou as datas que já vieram semeadas e vai propor outras.
  /// É o que alimenta a lista de pedidos de alteração da G&G — sem isso ela
  /// teria de comparar planos para descobrir quem mexeu no que estava combinado.
  changeRequested Boolean            @default(false)
  confirmedById   String?
  confirmedAt     DateTime?
  validatedById   String?
  validatedAt     DateTime?
  /// Reabertura pontual depois do prazo, concedida pela G&G. Reabre UM plano,
  /// e não o sistema inteiro: a exceção de uma pessoa não abre a porta a todos.
  unlockedUntil   DateTime?
  companyId       String             @default("company-emr")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  campaign    VacationCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entitlement VacationEntitlement  @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  confirmedBy User?                @relation("VacationPlansConfirmed", fields: [confirmedById], references: [id])
  validatedBy User?                @relation("VacationPlansValidated", fields: [validatedById], references: [id])
  company     Company              @relation(fields: [companyId], references: [id])
  periods     VacationPlanPeriod[]

  @@unique([campaignId, entitlementId])
  @@index([companyId, status])
}

/// Um período programado. Linha, e não `jsonb`, porque a coincidência de férias
/// do time precisa ser consultável ANTES da validação.
model VacationPlanPeriod {
  id        String   @id @default(cuid())
  planId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  days      Int
  soldDays  Int      @default(0)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  plan     VacationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  company  Company      @relation(fields: [companyId], references: [id])
  /// O `Vacation` que este período gerou ao ser validado. Null enquanto o plano
  /// não foi validado.
  vacation Vacation?    @relation("VacationFromPlan")

  @@index([planId])
  @@index([companyId, startDate])
}

// ============================================================================
// Eu Aprendiz — trilha do programa Jovem Aprendiz
// Spec: docs/superpowers/specs/2026-09-14-eu-aprendiz-design.md
// ============================================================================

/// `ACTIVITY` é ficha comum; `COMMITMENT` é o Cartão do Compromisso do Mês (um
/// por encontro); `REVIEW` é a revisão do compromisso do encontro ANTERIOR — a
/// única que lê a submissão de outro encontro, e por isso só existe a partir do 2º.
enum ApprenticeActivityKind {
  ACTIVITY
  COMMITMENT
  REVIEW
}

enum ApprenticeSurveyLearned {
  SIM
  EM_PARTE
  NAO
}

/// Turma do ciclo ("Turma A", turno "Manhã"). Model, e não enum `A | B`: a turma
/// é do ciclo, e o próximo ciclo tem outras — enum obrigaria migration só para
/// abrir uma turma da tarde.
model ApprenticeClass {
  id        String   @id @default(cuid())
  companyId String   @default("company-emr")
  name      String
  shift     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                @relation(fields: [companyId], references: [id])
  enrollments ApprenticeEnrollment[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

/// Matrícula de um aprendiz numa turma. A unique é por EMPRESA, e não por turma:
/// a pessoa está numa turma de cada vez, e abrir o próximo ciclo é mover a
/// matrícula. Histórico de ciclos é problema de quando houver um segundo.
model ApprenticeEnrollment {
  id        String   @id @default(cuid())
  companyId String   @default("company-emr")
  classId   String
  userId    String
  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  class   ApprenticeClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User            @relation("ApprenticeEnrollments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([classId])
}

/// Um encontro da trilha. O STATUS (Concluído/Próximo/Futuro) não é coluna: sai
/// de `meetingStatusesOf` em `@legends/shared`, pela data. Status editável ao
/// lado de uma data é status que alguém esquece de mudar.
model ApprenticeMeeting {
  id             String    @id @default(cuid())
  companyId      String    @default("company-emr")
  order          Int
  title          String
  theme          String    @default("")
  objectives     String[]  @default([])
  deliverable    String    @default("")
  /// Data civil: o encontro é de um dia, não de um instante.
  scheduledOn    DateTime? @db.Date
  accessReleased Boolean   @default(false)
  surveyOpen     Boolean   @default(false)
  slideUrl       String?
  /// Apresentação enviada como arquivo (S3). Convive com `slideUrl`: quem já
  /// tem o deck no Drive continua colando o link.
  slideKey       String?
  slideFileName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company         Company                     @relation(fields: [companyId], references: [id])
  materials       ApprenticeMeetingMaterial[]
  activities      ApprenticeActivity[]
  attendances     ApprenticeAttendance[]
  makeups         ApprenticeMakeup[]
  surveyResponses ApprenticeSurveyResponse[]
  surveyReceipts  ApprenticeSurveyReceipt[]
  tasks           ApprenticeTask[]

  @@unique([companyId, order])
  @@index([companyId, scheduledOn])
}

/// Material complementar do encontro: link externo OU arquivo no S3. O
/// protótipo usava `URL.createObjectURL`, que só existe naquela aba do
/// navegador — aqui o arquivo é de verdade.
model ApprenticeMeetingMaterial {
  id        String   @id @default(cuid())
  companyId String   @default("company-emr")
  meetingId String
  name      String
  /// Link externo. Exatamente UM entre `url` e `documentKey` fica preenchido.
  url       String?
  /// Chave do arquivo no S3. Chave, e não URL: a leitura sai assinada e
  /// temporária no serialize, como o comprovante de treinamento.
  documentKey String?
  fileName    String?
  contentType String?
  sizeBytes   Int?
  createdAt DateTime @default(now())

  company Company           @relation(fields: [companyId], references: [id])
  meeting ApprenticeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([companyId, meetingId])
}

/// Uma ficha do encontro. TUDO é ficha dinâmica aqui — inclusive o Mapa de
/// Forças e a Linha do Tempo, que no protótipo eram componentes fixos em código.
/// Um caminho de renderização só, e a G&G muda uma pergunta sem deploy.
model ApprenticeActivity {
  id        String                 @id @default(cuid())
  companyId String                 @default("company-emr")
  meetingId String
  order     Int                    @default(0)
  kind      ApprenticeActivityKind @default(ACTIVITY)
  title     String
  /// Blocos e campos — ver `ApprenticeActivitySchema` em `@legends/shared`.
  schema    Json                   @default("{\"blocks\":[]}")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  company     Company                @relation(fields: [companyId], references: [id])
  meeting     ApprenticeMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  submissions ApprenticeSubmission[]

  @@index([companyId, meetingId])
}

/// A ficha preenchida por um aprendiz. Conteúdo PRIVADO: só o próprio e o
/// facilitador leem. No mural entra o status da entrega, nunca o que foi escrito.
model ApprenticeSubmission {
  id           String    @id @default(cuid())
  companyId    String    @default("company-emr")
  activityId   String
  userId       String
  values       Json      @default("{}")
  /// Nulo enquanto é rascunho. Enviado é o que conta como entrega.
  submittedAt  DateTime?
  draftSavedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  activity ApprenticeActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User               @relation("ApprenticeSubmissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([companyId, userId])
}

/// Chamada nominal. É a ÚNICA presença: o protótipo tinha também um booleano por
/// (encontro, turma), e dois mecanismos para o mesmo fato divergem.
model ApprenticeAttendance {
  id            String   @id @default(cuid())
  companyId     String   @default("company-emr")
  meetingId     String
  userId        String
  /// `null` = chamada ainda não lançada. É o que distingue "faltou" de "ninguém
  /// chamou" — e só o primeiro tranca o encontro seguinte.
  present       Boolean?
  justification String?
  needsMakeup   Boolean  @default(false)
  recordedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  meeting    ApprenticeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User              @relation("ApprenticeAttendances", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User?             @relation("ApprenticeAttendancesRecorded", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([companyId, meetingId])
}

/// Reposição agendada para quem faltou. Ela NÃO destrava o encontro seguinte
/// sozinha: é compromisso de agenda, não registro de que a pessoa compareceu —
/// quem destrava é o facilitador corrigindo a chamada depois.
model ApprenticeMakeup {
  id          String   @id @default(cuid())
  companyId   String   @default("company-emr")
  meetingId   String
  /// Instante: a reposição tem hora marcada.
  scheduledAt DateTime
  createdById String?
  createdAt   DateTime @default(now())

  company   Company                    @relation(fields: [companyId], references: [id])
  meeting   ApprenticeMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User?                      @relation("ApprenticeMakeupsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  attendees ApprenticeMakeupAttendee[]

  @@index([companyId, scheduledAt])
}

model ApprenticeMakeupAttendee {
  id        String @id @default(cuid())
  companyId String @default("company-emr")
  makeupId  String
  userId    String

  company Company          @relation(fields: [companyId], references: [id])
  makeup  ApprenticeMakeup @relation(fields: [makeupId], references: [id], onDelete: Cascade)
  user    User             @relation("ApprenticeMakeupAttendances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([makeupId, userId])
  @@index([companyId, userId])
}

/// Resposta da pesquisa de satisfação. **Sem `userId`, de propósito.** Quem já
/// respondeu fica em `ApprenticeSurveyReceipt`, que é outra tabela e não tem
/// coluna nenhuma ligando uma linha à outra. Isso protege o anonimato no BANCO;
/// na tela, com três aprendizes, o texto livre identifica quem escreveu — a
/// garantia é estrutural, não estatística (ver a spec).
model ApprenticeSurveyResponse {
  id          String                  @id @default(cuid())
  companyId   String                  @default("company-emr")
  meetingId   String
  score       Int
  takeaway    String
  improvement String                  @default("")
  learned     ApprenticeSurveyLearned
  createdAt   DateTime                @default(now())

  company Company           @relation(fields: [companyId], references: [id])
  meeting ApprenticeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([companyId, meetingId])
}

/// Recibo de "esta pessoa já respondeu", para não pedir a pesquisa duas vezes.
/// E só para isso — ver o comentário de `ApprenticeSurveyResponse`.
model ApprenticeSurveyReceipt {
  id        String   @id @default(cuid())
  companyId String   @default("company-emr")
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  company Company           @relation(fields: [companyId], references: [id])
  meeting ApprenticeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User              @relation("ApprenticeSurveyReceipts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([companyId, meetingId])
}

/// Contrato da trilha: as cláusulas acordadas no primeiro encontro. Uma linha
/// por empresa — é um documento só, que a G&G edita.
model ApprenticeContract {
  id          String   @id @default(cuid())
  companyId   String   @unique @default("company-emr")
  clauses     String[] @default([])
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company                       @relation(fields: [companyId], references: [id])
  updatedBy  User?                         @relation("ApprenticeContractsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  signatures ApprenticeContractSignature[]
}

model ApprenticeContractSignature {
  id         String   @id @default(cuid())
  companyId  String   @default("company-emr")
  contractId String
  userId     String
  signedAt   DateTime @default(now())

  company  Company            @relation(fields: [companyId], references: [id])
  contract ApprenticeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User               @relation("ApprenticeContractSignatures", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([companyId, userId])
}

// ---- Eu Aprendiz, Fase 2: jornada, movimentações e quadro de gestão ----

/// Coluna do quadro interno do RH. `boardColumn`, e não `column`: palavra
/// reservada em SQL só funciona entre aspas, e não vale o risco.
enum ApprenticeTaskColumn {
  AFAZER
  ANDAMENTO
  VALIDACAO
  CONCLUIDO
}

/// O que a jornada do aprendiz tem e o cadastro do colaborador NÃO tem.
///
/// Setor, squad, líder, admissão e férias moram em `User` e no planejamento de
/// férias da Liderança — reimplementá-los aqui seria um segundo cadastro da
/// mesma pessoa, divergindo do primeiro no dia seguinte. Sobra só isto.
model ApprenticeJourney {
  id             String    @id @default(cuid())
  companyId      String    @default("company-emr")
  /// `@unique` no userId só, e não composto com `companyId`: a jornada é 1-1 com
  /// a pessoa, e o usuário já pertence a uma empresa só.
  userId         String    @unique
  /// Fim PREVISTO do contrato de aprendizagem — data civil. Não é `User.leftAt`,
  /// que é quando a pessoa efetivamente saiu.
  contractEndsOn DateTime? @db.Date
  /// Atividades sob responsabilidade, uma por linha.
  activities     String    @default("")
  notes          String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  user      User    @relation("ApprenticeJourney", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ApprenticeJourneysUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId])
}

/// Histórico de troca de setor do aprendiz. É o que a elegibilidade lê para
/// saber há quanto tempo a pessoa está no setor ATUAL — sem isto, a conta
/// cairia sempre na data de admissão e todo mundo pareceria elegível.
model ApprenticeSectorMove {
  id           String   @id @default(cuid())
  companyId    String   @default("company-emr")
  userId       String
  fromSector   String   @default("")
  toSector     String
  /// Data civil da mudança.
  movedOn      DateTime @db.Date
  reason       String   @default("")
  responsibles String   @default("")
  createdById  String?
  createdAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  user      User    @relation("ApprenticeSectorMoves", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ApprenticeSectorMovesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, userId])
  @@index([companyId, movedOn])
}

/// Quadro operacional do RH: o que o facilitador precisa fazer para o encontro
/// acontecer. NÃO é visível para o aprendiz — não confunda com
/// `ApprenticeActivity`, que é a ficha que ele preenche.
model ApprenticeTask {
  id          String               @id @default(cuid())
  companyId   String               @default("company-emr")
  title       String
  category    String               @default("Outros")
  /// Encontro relacionado; nulo = tarefa geral do programa.
  meetingId   String?
  dueOn       DateTime?            @db.Date
  boardColumn ApprenticeTaskColumn @default(AFAZER)
  sortOrder   Int                  @default(0)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  meeting   ApprenticeMeeting?   @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy User?                @relation("ApprenticeTasksCreated", fields: [createdById], references: [id], onDelete: SetNull)
  items     ApprenticeTaskItem[]

  @@index([companyId, boardColumn])
}

model ApprenticeTaskItem {
  id        String   @id @default(cuid())
  companyId String   @default("company-emr")
  taskId    String
  text      String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  task    ApprenticeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([companyId, taskId])
}

// ---------------------------------------------------------------------------
// Metas e OKRs — ciclos, objetivos, key results e check-ins.
// Spec: docs/superpowers/specs/2026-09-17-modulo-metas-okr-design.md
//
// O check-in é o FATO: o valor atual de um KR é derivado da série, nunca uma
// coluna do KR. Guardá-lo no KR é o que faz a ImpulseUp (a origem importada)
// não ter histórico nenhum.
// ---------------------------------------------------------------------------

enum OkrCycleStatus {
  OPEN
  CLOSED
  DRAFT
}

enum OkrScope {
  ORGANIZATION
  TEAM
  INDIVIDUAL
}

enum OkrStatus {
  ACTIVE
  ARCHIVED
  CANCELLED
}

enum OkrVisibility {
  EVERYONE
  ASSIGNEES
  PRIVATE
}

enum OkrAggregation {
  KR_ONLY
  WEIGHTED_KRS
  CHILDREN
  MANUAL
}

enum OkrConfidenceLevel {
  ON_TRACK
  ATTENTION_REQUIRED
  AT_RISK
  COMPLETED
}

enum OkrMetricType {
  PERCENTAGE
  NUMBER
  CURRENCY
}

/// Substitui o `inverted` da ImpulseUp, que existe no dado e é ignorado no
/// cálculo de lá: métrica "menor é melhor" que estoura a meta aparecia azul.
enum OkrDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum OkrSubjectType {
  OBJECTIVE
  KEY_RESULT
}

enum OkrRole {
  OWNER
  CREATOR
  ASSIGNED_TO
}

enum OkrCheckInSource {
  MANUAL
  AUTOMATION
  IMPULSEUP_IMPORT
}

enum OkrDependencyStrategy {
  AVERAGE
  SUM
  WEIGHTED_AVERAGE
}

enum OkrDependencyCalcType {
  PROGRESS
  VALUE
}

model OkrCycle {
  id                    String         @id @default(cuid())
  companyId             String         @default("company-emr")
  name                  String
  description           String?        @db.Text
  status                OkrCycleStatus @default(DRAFT)
  startDate             DateTime       @db.Date
  finishDate            DateTime       @db.Date
  /// Check-in sem comentário é recusado (422).
  forceCommentOnCheckIn Boolean        @default(false)
  /// Janela em que quem não é admin pode registrar check-in. Lado nulo = aberto.
  updateWindowStart     DateTime?      @db.Date
  updateWindowFinish    DateTime?      @db.Date
  /// Semáforo: `{ min, max, color }[]`, em pontos percentuais de atingimento.
  progressRanges        Json           @default("[]")
  /// Casas decimais por tipo: `{ percentage, numeric, currency }`.
  decimals              Json           @default("{}")
  externalSource        String?
  externalId            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  objectives OkrObjective[]

  // NULL é distinto no Postgres: equivale ao índice único parcial "onde há
  // origem externa", e o Prisma consegue usá-lo.
  @@unique([companyId, externalSource, externalId])
  @@index([companyId, status])
}

model OkrObjective {
  id              String              @id @default(cuid())
  companyId       String              @default("company-emr")
  cycleId         String
  parentId        String?
  /// Código legível (na ImpulseUp, `spreadsheetId`).
  code            String?
  name            String
  description     String?             @db.Text
  scope           OkrScope
  status          OkrStatus           @default(ACTIVE)
  visibility      OkrVisibility       @default(EVERYONE)
  finishDate      DateTime?           @db.Date
  /// Peso dentro do pai; nulo divide igualmente o que sobra.
  weight          Float?
  aggregation     OkrAggregation      @default(KR_ONLY)
  /// Atingimento informado (0–1), só lido quando `aggregation = MANUAL`.
  manualProgress  Float?
  confidenceLevel OkrConfidenceLevel?
  /// Alinhamento materializado: ids da raiz até este objetivo, inclusive.
  path            String[]
  deletedAt       DateTime?
  externalSource  String?
  externalId      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  cycle      OkrCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parent     OkrObjective?  @relation("OkrObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   OkrObjective[] @relation("OkrObjectiveTree")
  keyResults OkrKeyResult[]

  @@unique([companyId, externalSource, externalId])
  @@index([cycleId, scope])
  @@index([parentId])
}

model OkrKeyResult {
  id             String        @id @default(cuid())
  companyId      String        @default("company-emr")
  objectiveId    String
  code           String?
  name           String
  description    String?       @db.Text
  metricType     OkrMetricType
  unit           String?
  baseline       Float         @default(0)
  target         Float
  direction      OkrDirection  @default(HIGHER_IS_BETTER)
  weight         Float?
  status         OkrStatus     @default(ACTIVE)
  finishDate     DateTime?     @db.Date
  externalSource String?
  externalId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company           @relation(fields: [companyId], references: [id])
  objective    OkrObjective      @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  checkIns     OkrCheckIn[]
  dependencies OkrKrDependency[] @relation("OkrKrDependencyOwner")
  dependents   OkrKrDependency[] @relation("OkrKrDependencyTarget")

  @@unique([companyId, externalSource, externalId])
  @@index([objectiveId])
}

/// Papel de uma pessoa num objetivo ou num KR. Polimórfico de propósito: os
/// mesmos três papéis valem para os dois, e a unique fica simples.
model OkrAssignment {
  id          String         @id @default(cuid())
  companyId   String         @default("company-emr")
  subjectType OkrSubjectType
  subjectId   String
  personId    String
  role        OkrRole
  createdAt   DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id])
  person  User    @relation("OkrAssignments", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([subjectType, subjectId, personId, role])
  @@index([personId, role])
  @@index([subjectType, subjectId])
}

model OkrCheckIn {
  id             String           @id @default(cuid())
  companyId      String           @default("company-emr")
  keyResultId    String
  /// Nulo = check-in só de comentário (o que a ImpulseUp exporta).
  value          Float?
  /// Meta que é razão: guardar as duas partes é o que permite o acumulado do
  /// ciclo (a média das porcentagens não é a porcentagem do total).
  numerator      Float?
  denominator    Float?
  comment        String?          @db.Text
  authorId       String?
  /// Competência (a sprint/mês a que se refere), separada de `createdAt`.
  effectiveAt    DateTime         @db.Date
  source         OkrCheckInSource @default(MANUAL)
  sourceRef      String?
  externalSource String?
  externalId     String?
  createdAt      DateTime         @default(now())
  createdById    String?
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  company   Company      @relation(fields: [companyId], references: [id])
  keyResult OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  author    User?        @relation("OkrCheckInAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("OkrCheckInCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, externalSource, externalId])
  @@index([keyResultId, effectiveAt(sort: Desc)])
}

/// KR calculado a partir de outros KRs. Um KR com linhas aqui é somente leitura.
model OkrKrDependency {
  id            String                @id @default(cuid())
  companyId     String                @default("company-emr")
  keyResultId   String
  dependsOnKrId String
  weight        Float?
  strategy      OkrDependencyStrategy @default(AVERAGE)
  calcType      OkrDependencyCalcType @default(PROGRESS)

  company   Company      @relation(fields: [companyId], references: [id])
  keyResult OkrKeyResult @relation("OkrKrDependencyOwner", fields: [keyResultId], references: [id], onDelete: Cascade)
  dependsOn OkrKeyResult @relation("OkrKrDependencyTarget", fields: [dependsOnKrId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, dependsOnKrId])
}
