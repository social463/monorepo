model VotingPeriod {
  id        String             @id @default(cuid())
  monthRef  String // formato "2026-06"; único POR SETOR (ver @@unique abaixo)
  sectorId  String             @default("sector-dev-produto")
  companyId String             @default("company-emr")
  startsAt  DateTime
  endsAt    DateTime
  status    VotingPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now())

  winnerId           String?
  winnerVotes        Int?
  highlightMonthRef  String?
  highlightText      String?
  highlightImagePath String?
  highlightStatus    HighlightStatus @default(NONE)

  votes   Vote[]
  winner  User?   @relation("PeriodWinner", fields: [winnerId], references: [id])
  sector  Sector  @relation(fields: [sectorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([sectorId, monthRef], name: "one_period_per_sector_month", map: "one_period_per_sector_month")
  @@index([companyId])
}

/// Destaque do mês CURADO pela G&G — uma linha por (mês, pessoa).
///
/// Não é o Destaque do Mês da votação, que vive em `VotingPeriod` (winnerId,
/// highlightText, card de IA) e continua existindo: lá o vencedor sai dos votos
/// e é um por setor; aqui a escolha é editorial e o mês tem quantas pessoas a
/// G&G quiser. Pendurar isto no período amarraria o reconhecimento ao ciclo da
/// votação — janela, status e a unique de um vencedor por setor.
model MonthlyHighlight {
  id          String   @id @default(cuid())
  /// "AAAA-MM", o mesmo formato do `monthRef` da votação.
  monthRef    String
  userId      String
  /// SNAPSHOT do setor no cadastro: quem muda de setor em março não reescreve
  /// o quadro de janeiro. Mesmo princípio do `sectorId` de `AnalyticsEvent`.
  sectorId    String
  /// Justificativa — o texto que hoje a G&G manda por fora. Opcional porque o
  /// quadro costuma sair antes de a justificativa individual ficar pronta.
  message     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("company-emr")

  user      User    @relation("MonthlyHighlightPerson", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MonthlyHighlightCreator", fields: [createdById], references: [id])
  sector    Sector  @relation(fields: [sectorId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, monthRef, userId])
  @@index([companyId, monthRef])
  @@index([userId])
}

/// Que celebração um mural de aniversário comemora. As duas datas convivem no
/// mesmo model porque o mural é o mesmo objeto — muda só o que se comemora.
enum CelebrationKind {
  /// Aniversário de nascimento (`User.birthDate`).
  BIRTH
  /// Aniversário de casa (`User.joinedAt`), o "tempo de casa".
  WORK
}

/// Uma assinatura no mural de aniversário de alguém.
///
/// NÃO é feedback, de propósito: felicitação não tem situação/comportamento/
/// impacto, não escolhe categoria, não paga coins e não conta para selo. Era
/// isso que o botão de parabéns fazia antes — abria o `FeedbackComposer` com
/// um rascunho —, e o resultado era "Parabéns, Victoria!" no meio da lista de
/// feedbacks da pessoa. Ver a spec `2026-08-31-mural-de-aniversarios-design`.
///
/// O mural é identificado por (pessoa, tipo, ano): o de 2026 não se mistura
/// com o de 2025, e o de nascimento não se mistura com o de casa. Uma
/// assinatura por pessoa por mural (a unique), editável e apagável — o mural é
/// um cartão coletivo assinado, não uma conversa.
model BirthdayGreeting {
  id             String          @id @default(cuid())
  /// Quem faz aniversário.
  targetId       String
  /// Quem assinou.
  authorId       String
  kind           CelebrationKind
  /// Ano civil da ocorrência comemorada (o ano do mural, não o de nascimento).
  occurrenceYear Int
  message        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companyId      String          @default("company-emr")

  target    User                       @relation("BirthdayGreetingTarget", fields: [targetId], references: [id], onDelete: Cascade)
  author    User                       @relation("BirthdayGreetingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company   Company                    @relation(fields: [companyId], references: [id])
  reactions BirthdayGreetingReaction[]

  @@unique([companyId, targetId, kind, occurrenceYear, authorId])
  @@index([companyId, targetId, kind, occurrenceYear])
  @@index([authorId])
}

/// Reação a uma assinatura do mural — mesmo desenho de `FeedbackReaction`.
model BirthdayGreetingReaction {
  id         String   @id @default(cuid())
  greetingId String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  greeting BirthdayGreeting @relation(fields: [greetingId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id])

  @@unique([greetingId, userId, emoji])
  @@index([greetingId])
  @@index([companyId])
}

model Vote {
  id            String   @id @default(cuid())
  voterId       String
  votedId       String
  periodId      String
  companyId     String   @default("company-emr")
  justification String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voter      User           @relation("VotesGiven", fields: [voterId], references: [id])
  voted      User           @relation("VotesReceived", fields: [votedId], references: [id])
  period     VotingPeriod   @relation(fields: [periodId], references: [id])
  company    Company        @relation(fields: [companyId], references: [id])
  categories VoteCategory[]
  feedback   Feedback?

  @@unique([voterId, periodId], name: "one_vote_per_voter_period")
  @@index([periodId])
  @@index([votedId])
  @@index([companyId])
}

model VoteCategory {
  voteId     String
  categoryId String

  vote     Vote                @relation(fields: [voteId], references: [id], onDelete: Cascade)
  category RecognitionCategory @relation(fields: [categoryId], references: [id])

  @@id([voteId, categoryId])
  @@index([categoryId])
}

model Badge {
  id              String    @id @default(cuid())
  /// Único **por empresa**, não no banco inteiro: num produto white label o
  /// selo "Inovador" da empresa A não pode impedir a empresa B de ter o dela —
  /// e o `destaque-do-mes`, que o `publishHighlight` procura por slug, precisa
  /// existir uma vez em cada empresa.
  slug            String
  name            String
  description     String
  kind            BadgeKind
  iconKey         String
  threshold       Int       @default(0)
  /// ATENÇÃO: **não** é o tema do selo — é o `slug` de uma `RecognitionCategory`,
  /// e é o que um selo de tipo CATEGORY conta ("dez feedbacks em Colaboração").
  /// Texto sem FK de propósito (ver AGENTS.md). O tema do catálogo é
  /// `badgeCategoryId`, outro campo e outro conceito.
  categorySlug    String?
  /// Tema do selo no catálogo (Documento 4, seção 11.4): a gaveta em que ele
  /// aparece no Painel de Emblemas. Opcional — selo sem tema cai em "Sem
  /// categoria", em vez de receber um chute na migração.
  badgeCategoryId String?
  /// Recompensa ao conquistar, em Pontos e em EMR Coins. Nulos por padrão, e
  /// nulo não é zero: o formulário precisa distinguir "não configurado" de
  /// "zero digitado". Nenhum dos dois é obrigatório.
  rewardPoints    Int?
  rewardCoins     Int?
  global          Boolean   @default(true)
  companyId       String    @default("company-emr")

  company       Company        @relation(fields: [companyId], references: [id])
  badgeCategory BadgeCategory? @relation(fields: [badgeCategoryId], references: [id], onDelete: SetNull)
  awarded       UserBadge[]
  sectors       BadgeSector[]
  claims        BadgeClaim[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([badgeCategoryId])
}

/// Tema do selo — a prateleira do catálogo (Documento 4, seções 11.3 e 11.4).
///
/// Não confundir com `RecognitionCategory`: aquela é a categoria do FEEDBACK, e
/// é ela que `Badge.categorySlug` referencia. Esta só organiza a tela do admin
/// e agrupa o catálogo. Fundir as duas faria um selo do tema "Cultura" passar a
/// contar feedbacks de uma categoria "Cultura" que pode nem existir.
///
/// Desativa-se, não se apaga: o `slug` é o que a importação por planilha casa.
model BadgeCategory {
  id        String   @id @default(cuid())
  name      String
  /// Único **por empresa**, como `Badge.slug` e `Sector.slug` — em model
  /// tenant-scoped, índice único de nome/slug leva `companyId` junto.
  slug      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  badges  Badge[]

  @@unique([companyId, slug])
  @@index([companyId, order])
}

enum BadgeClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Reivindicação de selo feita pelo próprio colaborador (Documento 4, seção
/// 11.2): o relato da conquista, a comprovação e o veredito da G&G.
///
/// Existe porque nem todo selo é contável pelo sistema. Sem isto, o único
/// caminho era pedir no Teams e torcer para alguém conceder na mão.
model BadgeClaim {
  id              String                       @id @default(cuid())
  badgeId         String
  userId          String
  /// Relato da conquista. Obrigatório — é o que a G&G lê para decidir.
  story           String
  /// Chave S3 da comprovação (imagem ou PDF); o DTO expõe URL ASSINADA, nunca
  /// a chave. Comprovação é material de uma pessoa, e o bucket é público.
  attachmentKey   String?
  attachmentKind  CorporatePostAttachmentKind?
  /// Alternativa ao anexo: link do certificado, foto ou documento.
  link            String?
  status          BadgeClaimStatus             @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  companyId       String                       @default("company-emr")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  badge      Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User    @relation("BadgeClaims", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("BadgeClaimsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  company    Company @relation(fields: [companyId], references: [id])

  /// Uma reivindicação ATIVA por (pessoa, selo) é garantida por um índice único
  /// PARCIAL que vive só no SQL da migration (WHERE status <> 'REJECTED') — o
  /// Prisma não sabe representar índice parcial, e declará-lo aqui faria todo
  /// `migrate dev` futuro propor recriá-lo sem o WHERE. Mesmo mecanismo de
  /// `ChallengeSubmission`. Violação chega como P2002.
  @@index([companyId, status, createdAt])
  @@index([badgeId])
  @@index([userId])
}

model BadgeSector {
  badgeId  String
  sectorId String

  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([badgeId, sectorId])
}

model UserBadge {
