model CalendarConnection {
  id                   String                   @id @default(cuid())
  userId               String
  companyId            String
  provider             CalendarProvider
  providerAccountEmail String
  /// Cifrado por lib/crypto.ts — nunca sai da API.
  accessTokenEnc       String
  accessTokenExpiresAt DateTime
  /// Cifrado por lib/crypto.ts — nunca sai da API.
  refreshTokenEnc      String
  scopes               String
  status               CalendarConnectionStatus @default(ACTIVE)
  /// Fase 3: opt-out de publicar eventos do Legends nesta agenda.
  publishEnabled       Boolean                  @default(true)
  /// Fase 2: syncToken (Google) / deltaLink (Graph).
  syncCursor           String?
  lastSyncAt           DateTime?
  lastSyncError        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, provider])
  @@index([companyId])
  @@index([status])
}

model OfficeDeskReminder {
  id          String    @id @default(cuid())
  deskId      String
  senderId    String
  recipientId String
  message     String
  giftX       Float     @default(0.5)
  giftY       Float     @default(0.35)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  companyId   String    @default("company-emr")

  desk      OfficeDesk @relation(fields: [deskId], references: [id], onDelete: Cascade)
  sender    User       @relation("OfficeDeskReminderSender", fields: [senderId], references: [id])
  recipient User       @relation("OfficeDeskReminderRecipient", fields: [recipientId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])

  @@index([deskId, readAt])
  @@index([recipientId, readAt])
  @@index([senderId])
  @@index([companyId])
}

model OfficeMeeting {
  id              String    @id @default(cuid())
  companyId       String    @default("company-emr")
  roomExternalKey String
  roomName        String
  title           String
  agenda          String?
  startsAt        DateTime
  endsAt          DateTime
  organizerId     String
  canceledAt      DateTime?
  // Outlook/Google só atualizam um evento já importado se o SEQUENCE subir.
  sequence        Int       @default(0)
  remindedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizer    User                       @relation("OfficeMeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  company      Company                    @relation(fields: [companyId], references: [id])
  participants OfficeMeetingParticipant[]

  @@index([companyId, roomExternalKey, startsAt])
  @@index([organizerId])
  @@index([startsAt])
}

model OfficeMeetingParticipant {
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  meeting OfficeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User          @relation("OfficeMeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

/// Página de conteúdo institucional da área de Cultura (hoje só o manifesto).
/// Genérica de propósito: kit visual e galeria entram como novos slugs.
model CulturePage {
  id          String   @id @default(cuid())
  slug        String
  title       String
  subtitle    String?
  /// Corpo em Markdown — renderizado no front sem passar por HTML.
  body        String   @db.Text
  published   Boolean  @default(false)
  updatedById String?
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User?   @relation("CulturePagesUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([slug, companyId])
  @@index([companyId])
}

/// Manual interno (código de ética, política de bonificação…). O PDF fica no S3
/// e é referenciado pela CHAVE do objeto — nunca por URL pública, porque o
/// download precisa passar pela rota autenticada.
model CultureManual {
  id             String   @id @default(cuid())
  title          String
  description    String
  body           String?  @db.Text
  fileKey        String?
  fileName       String?
  fileSize       Int?
  /// Texto livre exibido no card, ex.: "Atualizado em junho/2024".
  referenceLabel String?
  order          Int      @default(0)
  published      Boolean  @default(true)
  companyId      String   @default("company-emr")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

/// Benefício ou canal de apoio exibido em card, com detalhe em modal.
model CultureBenefit {
  id        String   @id @default(cuid())
  title     String
  summary   String
  /// Nome do Material Symbol exibido no card.
  icon      String?
  body      String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

/// Como a imagem preenche o card do kit visual. CONTAIN existe para logo e selo,
/// que recortados perdem a forma; COVER para arte que sangra (banner, fundo).
enum CultureVisualAssetFit {
  COVER
  CONTAIN
}

/// Peça do kit de identidade visual (banner de LinkedIn, logotipo, fundo de
/// reunião). Diferente de CultureManual, a imagem NÃO é um anexo do card: ela é
/// o próprio produto — o mesmo objeto serve de preview e de download. Por isso
/// `storageKey` é obrigatório, e o prefixo é público (`visual-assets/`), ao
/// contrário do PDF de manual, que passa por rota autenticada.
model CultureVisualAsset {
  id          String                @id @default(cuid())
  title       String
  description String
  /// Chave do objeto no S3. A URL pública é resolvida no serialize, como em
  /// EventPhoto — nunca gravada, para a base pública poder mudar sem migration.
  storageKey  String
  /// Nome sugerido no download, ex.: `EMR-Banner-LinkedIn.png`.
  fileName    String
  fit         CultureVisualAssetFit @default(COVER)
  order       Int                   @default(0)
  published   Boolean               @default(true)
  companyId   String                @default("company-emr")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, order])
}

enum CulturePersonalAssetKind {
  IMAGE
  DOCUMENT
}

/// Material do kit entregue a UMA pessoa: foto do ensaio, certificado, carta.
///
/// Tabela separada de CultureVisualAsset, e a diferença é de segurança, não de
/// forma: a peça global mora em prefixo PÚBLICO do S3 e o DTO leva a URL direta;
/// aqui o prefixo é privado, `storageKey` nunca sai do servidor e o acesso passa
/// por link assinado de curta duração. Um `recipientId` opcional na mesma tabela
/// significaria que um valor errado publica a foto de alguém num CDN — e URL
/// vazada não se revoga.
model CulturePersonalAsset {
  id          String                   @id @default(cuid())
  /// Quem recebe. Um só por material: entrega para outra pessoa é outro envio.
  recipientId String
  title       String
  description String?
  /// Chave do objeto no S3, em prefixo privado. Nunca serializada.
  storageKey  String
  fileName    String
  fileSize    Int?
  kind        CulturePersonalAssetKind
  /// Quem publicou. SetNull para o material sobreviver à saída de quem o enviou.
  createdById String?
  companyId   String                   @default("company-emr")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  recipient User    @relation("CulturePersonalAssetsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CulturePersonalAssetsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, recipientId, createdAt])
  @@index([createdById])
}

/// Registro de navegação autenticada, base do People Analytics (`/admin/pessoas`).
/// Guarda só o *pathname* já normalizado (`/perfil/:id`) — nunca query string,
/// nunca PII além do `userId`.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  path      String
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  user    User    @relation("AccessLogs", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

/// Evento de uso do produto: quem exercitou qual fluxo, de qual empresa e setor.
///
/// Três registros vizinhos, propósitos distintos — não fundir:
/// - `AccessLog` é navegação (qual tela), base do People Analytics.
/// - `AdminAuditLog` é ação de admin sobre entidade, com before/after, e existe
///   para prestar contas.
/// - este é uso de produto, e sustenta o painel de adoção do super-admin.
///
/// `sectorId` é **snapshot denormalizado**, não relação: o setor que vale é o
/// de quando o evento aconteceu. Derivar por join com `User` faria quem muda de
/// setor levar todo o histórico junto, e a série por setor mentiria sobre o
/// passado.
///
/// `props` nunca recebe texto escrito por pessoa (justificativa de voto,
/// feedback) — só identificadores e contadores. Ver `@legends/shared/analytics`.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  sectorId   String?
  companyId  String   @default("company-emr")
  source     String   @default("api")
  props      Json?
  occurredAt DateTime @default(now())

  /// `SetNull`, não `Cascade`: apagar a pessoa apaga o vínculo com ela, mas
  /// preserva o agregado da empresa. Atende o direito à eliminação da LGPD sem
  /// abrir buraco retroativo no painel de adoção.
  user    User?   @relation("AnalyticsEvents", fields: [userId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, name, occurredAt])
  @@index([companyId, sectorId, occurredAt])
  @@index([name, occurredAt])
}

// ============================================================================
// Desenvolvimento — Aprendizado (LMS) e PDI
// ============================================================================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseLessonType {
  VIDEO
  TEXT
}

enum CourseEnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum CertificateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PdiPlanStatus {
  DRAFT
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PdiActionStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  DONE
}

enum PdiActionType {
  COURSE
  BOOK
  MENTORING
  PRACTICE
  OTHER
}

enum PdiActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum PdiShowcaseVisibility {
  ALL
  TEAM
  LEADER
  PRIVATE
}

enum PdiEvidenceKind {
  COMPLETION
  APPLICATION
}

enum PdiActionEventType {
  CREATED
  PROGRESS_UPDATED
  SUBMITTED_FOR_REVIEW
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}

/// Curso do catálogo de Aprendizado. Só curso publicado aparece para o colaborador.
model Course {
  id                          String      @id @default(cuid())
  title                       String
  slug                        String
  shortDescription            String?
  description                 String?     @db.Text
  coverUrl                    String?
  category                    String
  level                       CourseLevel @default(BEGINNER)
  /// Sem `durationMinutes`: a duração do curso é a soma das aulas, derivada na
  /// leitura. Um total digitado à mão desincroniza na primeira aula editada.
  /// Competências desenvolvidas (string[]).
  competencies                Json        @default("[]")
  /// Objetivos de aprendizagem (string[]).
  objectives                  Json        @default("[]")
  prerequisites               String?
  instructorName              String?
  instructorBio               String?
  mandatory                   Boolean     @default(false)
  certificateEnabled          Boolean     @default(true)
  published                   Boolean     @default(false)
  publishedAt                 DateTime?
  /// Nulo = curso visível para toda a empresa. Preenchido = só quem é do setor
  /// enxerga (ver "Recorte por setor" no spec). Nasce nulo em todo curso
  /// existente, então o comportamento atual é preservado por construção.
  sectorId                    String?
  /// Curso cuja emissão de certificado passa por fila de aprovação em vez de
  /// sair automaticamente ao concluir.
  requiresCertificateApproval Boolean     @default(false)
  /// Modelo visual usado no certificado emitido deste curso; nulo cai no
  /// isDefault da empresa e, na ausência dele, no visual atual.
  certificateTemplateId       String?
  companyId                   String      @default("company-emr")
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  company             Company               @relation(fields: [companyId], references: [id])
  sector              Sector?               @relation("CourseSector", fields: [sectorId], references: [id], onDelete: SetNull)
  certificateTemplate CertificateTemplate?  @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  modules             CourseModule[]
  lessons             CourseLesson[]
  enrollments         CourseEnrollment[]
  progress            LessonProgress[]
  favorites           CourseFavorite[]
  ratings             CourseRating[]
  certificates        Certificate[]
  trackLinks          LearningTrackCourse[]
  quizzes             CourseQuiz[]
  certificateRequests CertificateRequest[]

  @@unique([slug, companyId])
  @@index([companyId, published])
  @@index([companyId, category])
  @@index([companyId, sectorId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company        @relation(fields: [companyId], references: [id])
  lessons CourseLesson[]

  @@index([courseId, sortOrder])
  @@index([companyId])
}

model CourseLesson {
  id              String           @id @default(cuid())
  courseId        String
  moduleId        String
  title           String
  description     String?
  type            CourseLessonType @default(VIDEO)
  videoUrl        String?
  contentHtml     String?          @db.Text
  durationMinutes Int              @default(0)
  sortOrder       Int              @default(0)
  companyId       String           @default("company-emr")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id])
  progress LessonProgress[]
  quiz     CourseQuiz?

  @@index([moduleId, sortOrder])
  @@index([courseId])
  @@index([companyId])
}

model CourseEnrollment {
  id             String                 @id @default(cuid())
  userId         String
  courseId       String
  status         CourseEnrollmentStatus @default(IN_PROGRESS)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime?
  lastLessonId   String?
  companyId      String                 @default("company-emr")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user    User    @relation("CourseEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  certificateRequest CertificateRequest?

  @@unique([userId, courseId])
  @@index([companyId, userId])
  @@index([courseId])
}

/// Aula concluída. Idempotente por (userId, lessonId) — o progresso do curso é
/// sempre derivado daqui, nunca de um contador solto.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  courseId    String
  completedAt DateTime @default(now())
  companyId   String   @default("company-emr")

  user    User         @relation("LessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id])

  @@unique([userId, lessonId])
  @@index([companyId, userId, courseId])
}

model CourseFavorite {
  userId    String
  courseId  String
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  user    User    @relation("CourseFavorites", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@id([userId, courseId])
  @@index([companyId, userId])
}

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("CourseRatings", fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([companyId])
}

model LearningTrack {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverUrl     String?
  category     String
  /// Competências da trilha (string[]).
  competencies Json     @default("[]")
  sortOrder    Int      @default(0)
  published    Boolean  @default(false)
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id])
  courses LearningTrackCourse[]

  @@index([companyId, published, sortOrder])
}

model LearningTrackCourse {
  id        String   @id @default(cuid())
  trackId   String
  courseId  String
  sortOrder Int      @default(0)
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  track   LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id])

  @@unique([trackId, courseId])
  @@index([companyId])
}

/// Certificado emitido. `code` é público e verificável sem login (/certificado/:code).
model Certificate {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  courseId  String?
  title     String
  hours     Int
  imageUrl  String?
  issuedAt  DateTime @default(now())
  companyId String   @default("company-emr")

  user    User    @relation("Certificates", fields: [userId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, courseId])
  @@index([companyId, userId])
}

/// Quiz de uma aula ou o quiz final de um curso.
model CourseQuiz {
  id           String   @id @default(cuid())
  courseId     String
  /// Nulo = quiz final do curso; preenchido = quiz daquela aula. O `@unique`
  /// numa coluna nullable aceita vários NULL no Postgres, então garante "uma
  /// aula, no máximo um quiz" sem impedir que cada curso tenha o seu próprio
  /// quiz final. "Um quiz final por curso" NÃO é coberto por este índice —
  /// fica como regra de service, com teste (Task 5).
  lessonId     String?  @unique
  title        String
  passingScore Int      @default(70)
  /// Nulo = tentativas ilimitadas.
  maxAttempts  Int?
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    CourseLesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id])
  questions CourseQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([companyId])
}

/// Questão de múltipla escolha de um `CourseQuiz`.
model CourseQuestion {
  id          String   @id @default(cuid())
  quizId      String
  statement   String
  /// `[{ id, text, correct }]`, validado por schema Zod exportado de
  /// `@legends/shared`. O gabarito (`correct`) nunca sai no DTO de quem responde.
  options     Json
  explanation String?
  sortOrder   Int      @default(0)
  companyId   String   @default("company-emr")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz    CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@index([quizId, sortOrder])
  @@index([companyId])
}

/// Tentativa de resposta de um quiz por uma pessoa. `attemptNumber` é derivado
/// das tentativas anteriores no momento da submissão.
model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  attemptNumber Int
  score         Int
  passed        Boolean
  /// Respostas dadas nesta tentativa: `[{ questionId, optionId }]`.
  answers       Json
  companyId     String   @default("company-emr")
  createdAt     DateTime @default(now())

  quiz    CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User       @relation("QuizAttempts", fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@unique([quizId, userId, attemptNumber])
  @@index([companyId, userId])
}

/// Modelo visual de certificado (cores, assinatura, logo). Documento da
/// empresa — CRUD é sempre de ADMIN, nunca de SUBADMIN.
model CertificateTemplate {
  id                String   @id @default(cuid())
  name              String
  title             String
  backgroundUrl     String?
  accentColor       String
  signatureName     String
  signatureRole     String
  signatureImageUrl String?
  logoUrl           String?
  isDefault         Boolean  @default(false)
  companyId         String   @default("company-emr")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  courses Course[]

  @@index([companyId])
  @@index([companyId, isDefault])
}

/// Solicitação de emissão de certificado para curso com aprovação obrigatória.
/// Idempotente por `enrollmentId`: uma inscrição gera no máximo uma solicitação
/// viva por vez; recusar guarda o motivo e permite nova solicitação depois.
model CertificateRequest {
  id              String                   @id @default(cuid())
  enrollmentId    String                   @unique
  userId          String
  courseId        String
  status          CertificateRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  companyId       String                   @default("company-emr")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User             @relation("CertificateRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("CertificateRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  company    Company          @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([courseId])
}

/// Plano de desenvolvimento de uma pessoa num ciclo (ex.: 2026-Q1).
model PdiPlan {
  id          String        @id @default(cuid())
  userId      String
  leaderId    String?
  title       String
  status      PdiPlanStatus @default(DRAFT)
  cyclePeriod String?
  startsAt    DateTime?
  endsAt      DateTime?
  companyId   String        @default("company-emr")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User        @relation("PdiPlans", fields: [userId], references: [id], onDelete: Cascade)
  leader  User?       @relation("PdiPlansLed", fields: [leaderId], references: [id])
  company Company     @relation(fields: [companyId], references: [id])
  actions PdiAction[]

  @@index([companyId, userId])
  @@index([companyId, leaderId])
}

model PdiAction {
  id                   String            @id @default(cuid())
  planId               String
  description          String
  type                 PdiActionType     @default(OTHER)
  priority             PdiActionPriority @default(MEDIUM)
  status               PdiActionStatus   @default(NOT_STARTED)
  dueDate              DateTime?
  /// Progresso informado pela pessoa (0–100) — não é derivado, diferente do curso.
  progressPct          Int               @default(0)
  competency           String?
  notes                String?           @db.Text
  /// Itens do checklist ({ id, text, done }[]).
  checklist            Json              @default("[]")
  /// Respostas da reflexão guiada; preenchida na conclusão.
  reflection           Json?
  practicalApplication String?           @db.Text
  startedAt            DateTime?
  completedAt          DateTime?
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewComment        String?           @db.Text
  sharedAt             DateTime?
  companyId            String            @default("company-emr")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  plan       PdiPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("PdiActionsReviewed", fields: [reviewedById], references: [id])
  company    Company             @relation(fields: [companyId], references: [id])
  evidences  PdiActionEvidence[]
  history    PdiActionHistory[]

  promotedFromOneOnOne OneOnOneAction? @relation("OneOnOnePromotedAction")

  @@index([planId])
  @@index([companyId, status])
}

model PdiActionEvidence {
  id           String          @id @default(cuid())
  actionId     String
  kind         PdiEvidenceKind
  /// Chave do objeto no storage — nunca a URL (o download passa por rota assinada).
  storageKey   String?
  fileName     String?
  mimeType     String?
  externalUrl  String?
  uploadedById String
  companyId    String          @default("company-emr")
  createdAt    DateTime        @default(now())

  action     PdiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("PdiEvidencesUploaded", fields: [uploadedById], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([actionId])
  @@index([companyId])
}

model PdiActionHistory {
  id        String             @id @default(cuid())
  actionId  String
  eventType PdiActionEventType
  actorId   String?
  metadata  Json               @default("{}")
  companyId String             @default("company-emr")
  createdAt DateTime           @default(now())

  action  PdiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actor   User?     @relation("PdiActionEvents", fields: [actorId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@index([actionId, createdAt])
  @@index([companyId])
}

/// Painel externo de BI embutido na administração. `sectorId` null = painel da
/// empresa inteira. A FK de setor é Cascade de propósito: com SetNull, apagar um
/// setor promoveria seus painéis a painéis da empresa e exporia dado de RH do
/// setor para toda a administração.
model HrDashboard {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String
  height      Int      @default(720)
  sortOrder   Int      @default(0)
  sectorId    String?
  companyId   String   @default("company-emr")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, sectorId, sortOrder])
}

/// Agentes de IA disponíveis. O par AgentConversation/AgentMessage é genérico de
/// propósito — o que muda entre agentes é o system prompt e a fonte de contexto,
/// não o armazenamento. `GLASS` já existe aqui para o PBI #22282 reaproveitar a
/// mesma tabela em vez de clonar uma estrutura quase igual.
enum AgentKind {
  BENCHMARK
  GLASS
  ASSISTANT
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum GlassSentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

/// Avaliação externa (Glassdoor) colada por um administrador. Anônima por
/// construção: `createdById` é quem COLOU o texto, nunca quem o escreveu — não
/// existe coluna de autoria, e o prompt de extração é instruído a descartar
/// qualquer traço identificador que apareça no texto.
///
/// `status` e `tenure` seguem `String` (validados contra a lista fechada de
/// `@legends/shared` na escrita): o Glassdoor pode introduzir uma faixa nova, e
/// isso não deve exigir migration.
model GlassReview {
  id                 String          @id @default(cuid())
  companyId          String
  reviewDate         DateTime?
  /// Nota é 1,0 a 5,0. Decimal, não Float: média de RH em ponto flutuante vira
  /// 4.199999999999999 na tela.
  rating             Decimal?        @db.Decimal(2, 1)
  role               String?
  level              String?
  sector             String?
  tenure             String?
  status             String?
  recommends         Boolean?
  leadershipApproval Boolean?
  title              String?
  positives          String?
  negatives          String?
  advice             String?
  sentiment          GlassSentiment?
  themesPositive     String[]
  themesNegative     String[]
  /// Só os alertas POR AVALIAÇÃO. Os agregados (queda consecutiva, setor
  /// crítico) dependem das vizinhas e mudariam retroativamente a cada nova
  /// avaliação — são calculados na leitura, em `glass-overview-service`.
  alerts             String[]
  aiSummary          String?
  /// Fica null quando quem colou sai da base — a avaliação sobrevive à pessoa.
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("GlassReviewsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, reviewDate])
  @@index([companyId, sector])
}

/// Inventário de práticas internas de cultura — a base de comparação que o
/// agente de Benchmarking recebe como contexto. É da empresa inteira, sem
/// recorte por setor: ação de endomarketing não pertence a um setor.
model BenchmarkPractice {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  title       String
  description String?
  /// Canal de divulgação: LinkedIn, Teams, Notion…
  channel     String?
  tags        String[]
  /// Fica null quando quem cadastrou sai da base — a prática sobrevive à pessoa.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("BenchmarkPracticesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

/// Conversa com um agente. Sempre **da pessoa**: não existe conversa
/// compartilhada entre dois admins da mesma empresa.
model AgentConversation {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  agent     AgentKind
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  user     User           @relation("AgentConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([companyId, userId, agent, updatedAt])
}

model AgentMessage {
  id             String           @id @default(cuid())
  companyId      String
  conversationId String
  role           AgentMessageRole
  content        String
  createdAt      DateTime         @default(now())

  company      Company           @relation(fields: [companyId], references: [id])
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChallengeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Desafio proposto pela empresa ou por um setor. A recompensa é por desafio —
/// não passa por CoinRule, que só sabe valor fixo por evento.
model Challenge {
  id              String    @id @default(cuid())
  title           String
  description     String
  /// Coins creditados na aprovação. <= 0 não gera lançamento no extrato.
  rewardCoins     Int
  /// Chave manual de publicação. Nome com `is` de propósito: booleano chamado
  /// `active`/`status` não diz no call site *ativo o quê*.
  isActive        Boolean   @default(true)
  /// Uma de CHALLENGE_CATEGORIES (@legends/shared). String e não enum do Prisma:
  /// categoria é catálogo de produto, não invariante do banco — incluir uma não
  /// deve custar migration. O default existe só para a migration desta coluna;
  /// a API sempre exige categoria explícita.
  category        String    @default("Engajamento")
  /// Corpo longo em Markdown, renderizado por components/Markdown.tsx.
  /// NUNCA HTML: nada de markup vindo do banco chega ao DOM.
  detailsMarkdown String?
  /// Chave do S3 da imagem de capa. Guarda-se a chave, nunca a URL.
  imageKey        String?
  /// Ordem na vitrine; menor primeiro.
  position        Int       @default(0)
  /// Participação precisa passar pela fila de moderação. Persistido e exposto
  /// aqui; quem consome é o PBI "Resultados de Desafios".
  requiresReview  Boolean   @default(true)
  /// Não listado: some da vitrine, mas o detalhe continua servindo para quem
  /// está no escopo, de modo que um link compartilhado funciona.
  isPrivate       Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  /// Janela opcional; null dos dois lados = aberto enquanto `isActive`.
  startsAt        DateTime?
  endsAt          DateTime?
  /// null = desafio da empresa inteira (só ADMIN cria e modera).
  sectorId        String?
  companyId       String    @default("company-emr")
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sector      Sector?               @relation(fields: [sectorId], references: [id])
  company     Company               @relation(fields: [companyId], references: [id])
  createdBy   User                  @relation("ChallengesCreated", fields: [createdById], references: [id])
  submissions ChallengeSubmission[]

  @@index([companyId, isActive, position])
  @@index([companyId, sectorId])
}

model ChallengeSubmission {
  id              String                    @id @default(cuid())
  challengeId     String
  userId          String
  status          ChallengeSubmissionStatus @default(PENDING)
  note            String?
  /// Chave S3 da evidência opcional; o DTO expõe URL assinada, nunca a chave.
  evidenceKey     String?
  submittedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  companyId       String                    @default("company-emr")

  challenge  Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User      @relation("ChallengeSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ChallengeSubmissionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  company    Company   @relation(fields: [companyId], references: [id])

  /// Uma submissão ativa por (desafio, pessoa) é garantida por um índice único
  /// PARCIAL que vive só no SQL da migration (WHERE status <> 'REJECTED') — o
  /// Prisma não sabe representar índice parcial, e declará-lo aqui faria todo
  /// `migrate dev` futuro propor recriá-lo sem o WHERE. Violação chega como P2002.
  @@index([companyId, status, submittedAt])
  @@index([challengeId])
  @@index([userId])
}

/// Item do catálogo da loja. Do escopo da EMPRESA, não do setor: quem administra
/// é o bloco de Gente e Gestão (requireSectorFeature('gente-gestao')), e por isso
/// não há sectorId aqui.
model StoreProduct {
  id           String   @id @default(cuid())
  title        String
  description  String?
  /// Uma de STORE_PRODUCT_CATEGORIES (@legends/shared). String e não enum do Prisma,
  /// mesmo racional de Challenge.category: categoria é catálogo de produto, não
  /// invariante do banco — incluir uma não deve custar migration.
  category     String
  priceInCoins Int
  stock        Int      @default(0)
  /// Chave do S3 da capa. Guarda-se a CHAVE, nunca a URL.
  imageKey     String?
  isDigital    Boolean  @default(false)
  isActive     Boolean  @default(true)
  companyId    String   @default("company-emr")
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  createdBy User         @relation("StoreProductsCreated", fields: [createdById], references: [id])
  orders    StoreOrder[]

  @@index([companyId, isActive, category])
  @@index([companyId])
}

/// Pedido de resgate. `productTitle` e `pricePaid` são CONGELADOS no resgate: o
/// produto muda de nome e de preço depois, e o pedido é histórico.
model StoreOrder {
  id           String           @id @default(cuid())
  userId       String
  /// SetNull, e por isso opcional: apagar um produto não pode apagar o histórico de
  /// quem já resgatou. Cancelar pedido de produto apagado estorna os coins e pula a
  /// devolução de estoque — não há para onde devolver.
  productId    String?
  productTitle String
  pricePaid    Int
  status       StoreOrderStatus @default(PENDING)
  /// Nota INTERNA da G&G. Nunca sai no DTO do colaborador.
  adminNotes   String?
  handledById  String?
  handledAt    DateTime?
  companyId    String           @default("company-emr")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user      User          @relation("StoreOrders", fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  handledBy User?         @relation("StoreOrdersHandled", fields: [handledById], references: [id], onDelete: SetNull)
  company   Company       @relation(fields: [companyId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([productId])
}

/// Base de conhecimento curada por Gente e Gestão. `sectorId` null = vale para a
/// empresa inteira. A FK de setor é Cascade de propósito: com SetNull, apagar um
/// setor promoveria suas entradas a entradas da empresa e exporia resposta de RH
/// do setor para toda a companhia (mesma razão do HrDashboard).
model KnowledgeEntry {
  id          String   @id @default(cuid())
  category    String?
  question    String
  answer      String
  keywords    String[]
  isActive    Boolean  @default(true)
  sectorId    String?
  companyId   String   @default("company-emr")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdBy User    @relation("KnowledgeEntryAuthor", fields: [createdById], references: [id])

  @@index([companyId, isActive])
  @@index([companyId, sectorId])
}

/// Toda pergunta feita à assistente, com o que foi respondido e quais entradas
/// casaram. `matchedEntryIds` vazio marca uma lacuna da base.
model AssistantQuery {
  id              String   @id @default(cuid())
  userId          String
  question        String
  answer          String?
  matchedEntryIds String[]
  companyId       String   @default("company-emr")
  createdAt       DateTime @default(now())

  company  Company            @relation(fields: [companyId], references: [id])
  user     User               @relation("AssistantQueryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  feedback AssistantFeedback?

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

/// Um feedback por pergunta (reclicar atualiza). `rating` é -1 ou 1, validado no Zod.
model AssistantFeedback {
  id        String   @id @default(cuid())
  queryId   String   @unique
  userId    String
  rating    Int
  comment   String?
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  query   AssistantQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user    User           @relation("AssistantFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, rating])
}

enum CampaignAudience {
  ALL
  LEADERSHIP
}

enum CampaignChannel {
  MURAL
  TEAMS
  EMAIL
}

enum CampaignPostStatus {
  SCHEDULED
  PUBLISHED
  CANCELLED
}

/// Campanha de comunicação: o guarda-chuva editorial (tema + janela) sob o qual
/// nascem N comunicados agendados.
model Campaign {
  id          String           @id @default(cuid())
  theme       String
  startsAt    DateTime
  endsAt      DateTime
  audience    CampaignAudience
  notes       String?
  /// Fica null quando quem criou sai da base — a campanha sobrevive à pessoa
  /// (mesmo precedente de `BenchmarkPractice.createdById`).
  createdById String?
  companyId   String
  createdAt   DateTime         @default(now())

  createdBy User?          @relation("CampaignsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  company   Company        @relation(fields: [companyId], references: [id])
  posts     CampaignPost[]

  @@index([companyId, createdAt])
}

/// Item do calendário editorial. `campaignId` é opcional de propósito: é o que
/// permite criar item na mão quando a IA está indisponível.
model CampaignPost {
  id              String             @id @default(cuid())
  campaignId      String?
  title           String
  body            String
  visualHint      String?
  scheduledFor    DateTime
  channel         CampaignChannel
  audience        CampaignAudience
  status          CampaignPostStatus @default(SCHEDULED)
  responsibleId   String?
  publishedPostId String?            @unique
  publishedAt     DateTime?
  companyId       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  responsible   User?          @relation("CampaignPostsResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  // SetNull: apagar o post do mural não pode derrubar o histórico editorial.
  publishedPost CorporatePost? @relation(fields: [publishedPostId], references: [id], onDelete: SetNull)
  company       Company        @relation(fields: [companyId], references: [id])

  @@index([companyId, scheduledFor])
  @@index([companyId, status])
}

/// Álbum de fotos de um evento da empresa (confraternização, hackathon, onboarding).
model EventAlbum {
  id              String             @id @default(cuid())
  title           String
  description     String?
  eventDate       DateTime?
  /// Capa: FK para uma foto do próprio álbum. SetNull para que apagar a foto-capa
  /// não deixe o álbum apontando para objeto inexistente — a grade cai no fallback.
  coverPhotoId    String?            @unique
  /// Capa enviada no formulário, independente das fotos do álbum. Guarda a CHAVE
  /// do S3, como EventPhoto.storageKey. Tem precedência sobre `coverPhotoId`:
  /// quem subiu uma capa escolheu essa imagem de propósito.
  coverStorageKey String?
  /// Enquadramento da capa, aplicado igual no editor e na grade.
  coverFit        EventAlbumCoverFit @default(COVER)
  /// Posição vertical do recorte, 0 (topo) a 100 (base).
  coverPositionY  Int                @default(50)
  /// Zoom em porcentagem; 100 é a imagem sem ampliação.
  coverScale      Int                @default(100)
  createdById     String
  companyId       String             @default("company-emr")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  cover     EventPhoto?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos    EventPhoto[] @relation("AlbumPhotos")
  createdBy User         @relation("EventAlbumsCreated", fields: [createdById], references: [id])
  company   Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, eventDate])
}

/// Como a capa preenche o quadro do card: COVER corta o que sobra, CONTAIN cabe
/// inteira. Espelha `EVENT_ALBUM_COVER_FITS` no contrato compartilhado.
enum EventAlbumCoverFit {
  COVER
  CONTAIN
}

/// Foto de um álbum. Guarda a CHAVE do objeto no S3, nunca a URL — URL assinada
/// expira e URL pública gravada engessa o bucket. O serialize resolve a pública.
model EventPhoto {
  id           String   @id @default(cuid())
  albumId      String
  storageKey   String
  width        Int?
  height       Int?
  uploadedById String
  companyId    String   @default("company-emr")
  createdAt    DateTime @default(now())

  album      EventAlbum           @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
  coverOf    EventAlbum?          @relation("AlbumCover")
  uploadedBy User                 @relation("EventPhotosUploaded", fields: [uploadedById], references: [id])
  company    Company              @relation(fields: [companyId], references: [id])
  reactions  EventPhotoReaction[]
  comments   EventPhotoComment[]

  @@index([albumId, createdAt])
  @@index([companyId])
}

model EventPhotoReaction {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  photo   EventPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user    User       @relation("EventPhotoReactions", fields: [userId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@unique([photoId, userId, emoji])
  @@index([photoId])
  @@index([companyId])
}

model EventPhotoComment {
  id        String   @id @default(cuid())
  photoId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  photo   EventPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author  User       @relation("EventPhotoComments", fields: [authorId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id])

  @@index([photoId, createdAt])
  @@index([companyId])
}

/// Periodicidade de um evento de calendário cadastrado.
enum CalendarRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

///
/// Tipo de evento de calendário — "Provas B2B", "Comunicados", "Treinamentos".
/// É dado, não enum: cada empresa cadastra os seus, e o calendário desenha um
/// chip de filtro por tipo. Enum aqui custaria migration a cada tipo novo.
model CalendarEventType {
  id        String   @id @default(cuid())
  name      String
  slug      String
  icon      String   @default("event")
  /// Cor da categoria em hex. É o padrão aplicado sozinho ao evento no cadastro;
  /// o catálogo é por empresa, então a cor mora aqui e não num mapa fixo no front.
  color     String   @default("#6366f1")
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  events  CalendarEvent[]

  @@unique([companyId, slug])
  @@index([companyId])
}

///
/// Evento datado cadastrado pela empresa. `date` é a data civil da primeira (ou
/// única) ocorrência; as demais saem da regra de recorrência, expandidas na
/// leitura por `expandOccurrences` (@legends/shared) — nunca materializadas.
model CalendarEvent {
  id                 String             @id @default(cuid())
  title              String
  description        String             @default("")
  date               DateTime           @db.Date
  /// Último dia do evento; null quando ele cabe num dia só. A duração em dias
  /// acompanha cada ocorrência da recorrência, não só a primeira.
  endDate            DateTime?          @db.Date
  /// HH:MM local; null é evento de dia inteiro — e é o que joga a marcação para
  /// a faixa "DIA TODO" no topo da grade, em vez de uma faixa de horário.
  startTime          String?
  /// HH:MM local do fim. Sem `startTime` não significa nada.
  endTime            String?
  typeId             String
  /// Cor em hex sobrescrevendo a da categoria. Null é o caso normal.
  color              String?
  /// Público-alvo por tag, do mesmo vocabulário da planilha de colaboradores.
  /// **Vazio (ou contendo "Todos") é a empresa inteira** — e não "ninguém",
  /// mesma convenção de `CalendarEventSector`. As duas regras se somam.
  audienceTags       String[]           @default([])
  /// Ação de Comunicação Interna: registro da G&G que não vai para a empresa.
  /// Some da API para quem não é admin nem do time de Gente e Gestão.
  isInternalComm     Boolean            @default(false)
  recurrence         CalendarRecurrence @default(NONE)
  recurrenceUntil    DateTime?          @db.Date
  recurrenceCount    Int?
  /// Antecedências do lembrete em dias. Vazio = sem lembrete.
  reminderDaysBefore Int[]              @default([])
  createdById        String
  companyId          String             @default("company-emr")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  type      CalendarEventType           @relation(fields: [typeId], references: [id])
  createdBy User                        @relation("CalendarEventsCreated", fields: [createdById], references: [id])
  company   Company                     @relation(fields: [companyId], references: [id])
  sectors   CalendarEventSector[]
  reminders CalendarEventReminderSent[]

  @@index([companyId, date])
  @@index([typeId])
}

///
/// Público-alvo do evento. **Nenhuma linha significa empresa inteira** — e não
/// "ninguém". Marcar todos os setores no cadastro congelaria o público: setor
/// criado depois ficaria de fora de um evento que era de todo mundo.
model CalendarEventSector {
  eventId  String
  sectorId String

  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sector Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([eventId, sectorId])
  @@index([sectorId])
}

///
/// Reivindicação de um lembrete já disparado. A unique é o que impede lembrete
/// duplicado: o INSERT é a reivindicação, e violação (P2002) significa que outro
/// tick — ou outro processo — chegou primeiro.
///
/// A granularidade é (evento, ocorrência, antecedência), não o evento: evento
/// recorrente com duas antecedências tem várias linhas legítimas, e uma flag
/// única no evento responderia à pergunta errada.
model CalendarEventReminderSent {
  id             String   @id @default(cuid())
  eventId        String
  occurrenceDate DateTime @db.Date
  daysBefore     Int
  sentAt         DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate, daysBefore])
  @@index([eventId])
}

enum OneOnOneRecurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OneOnOneMeetingStatus {
  SCHEDULED
  DONE
  CANCELED
}

/// Resposta do CONVIDADO ao convite de 1:1 — de uma pessoa, não do encontro.
/// Não entra no `OneOnOneMeetingStatus` de propósito: aquele é o estado do
/// encontro para os dois, e misturar criaria estados sem sentido
/// ("recusado e realizado").
enum OneOnOneInviteResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum OneOnOneActionStatus {
  OPEN
  DONE
  PROMOTED
}

enum OneOnOneTopicOrigin {
  TEMPLATE
  CUSTOM
}

/// O par e o ritmo do 1:1. `userAId`/`userBId` são guardados ORDENADOS pelo id
/// (ver `normalizeOneOnOnePair` em @legends/shared): é o que torna "as ações
/// abertas deste par" uma consulta direta, e não um OR das duas combinações.
model OneOnOneSeries {
  id                 String                 @id @default(cuid())
  userAId            String
  userBId            String
  createdById        String
  recurrence         OneOnOneRecurrence     @default(NONE)
  recurrenceUntil    DateTime?
  durationMinutes    Int                    @default(30)
  endedAt            DateTime?
  /// A resposta do convidado que vale para a série inteira. A ocorrência só
  /// sobrescreve quando a pessoa disse algo diferente para aquele encontro
  /// (`OneOnOneMeeting.inviteeResponse`) — é o que impede uma série semanal de
  /// virar 52 pendências.
  inviteeResponse    OneOnOneInviteResponse @default(PENDING)
  inviteeRespondedAt DateTime?
  companyId          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  userA     User              @relation("OneOnOneUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User              @relation("OneOnOneUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdBy User              @relation("OneOnOneCreated", fields: [createdById], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])
  meetings  OneOnOneMeeting[]
  actions   OneOnOneAction[]

  @@index([companyId, userAId, userBId])
  @@index([companyId, userBId])
}

/// Uma ocorrência. MATERIALIZADA (diferente de CalendarEvent, cuja recorrência é
/// expandida em consulta): cada encontro carrega pauta, nota e ações próprias e
/// precisa de id estável para ser alvo de FK.
model OneOnOneMeeting {
  id                 String                  @id @default(cuid())
  seriesId           String
  startsAt           DateTime
  endsAt             DateTime
  status             OneOnOneMeetingStatus   @default(SCHEDULED)
  companyId          String
  /// Quando o lembrete de 10 minutos foi reivindicado. É o que impede lembrete
  /// duplicado: o UPDATE ... WHERE remindedAt IS NULL é atômico (ver
  /// `scheduler/one-on-one-reminders.ts`). Remarcar zera o campo — horário novo,
  /// lembrete novo.
  remindedAt         DateTime?
  /// Exceção da série: `null` significa "segue a resposta da série". Só é
  /// preenchido quando o convidado responde diferente para ESTA ocorrência.
  inviteeResponse    OneOnOneInviteResponse?
  inviteeRespondedAt DateTime?
  /// Contraproposta de horário do convidado, e o motivo da recusa. Sempre da
  /// ocorrência, mesmo quando a recusa vale para a série: o que se propõe é um
  /// horário concreto, e horário é de um encontro.
  proposedStartsAt   DateTime?
  declineNote        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  series  OneOnOneSeries        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  company Company               @relation(fields: [companyId], references: [id])
  topics  OneOnOneTopic[]
  notes   OneOnOnePrivateNote[]
  actions OneOnOneAction[]      @relation("OneOnOneActionCreatedIn")

  @@index([seriesId, startsAt])
  @@index([companyId, startsAt])
}

/// Item de pauta. O texto vindo do catálogo é COPIADO, não referenciado por FK:
/// o catálogo muda, a pauta de um encontro passado é registro histórico.
model OneOnOneTopic {
  id          String              @id @default(cuid())
  meetingId   String
  text        String
  origin      OneOnOneTopicOrigin @default(CUSTOM)
  discussed   Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdById String
  companyId   String
  createdAt   DateTime            @default(now())

  meeting   OneOnOneMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User            @relation("OneOnOneTopicsCreated", fields: [createdById], references: [id])
  company   Company         @relation(fields: [companyId], references: [id])

  @@index([meetingId, sortOrder])
  @@index([companyId])
}

/// A observação privada. Uma por pessoa por encontro. NUNCA sai da API para o
/// outro participante — a consulta filtra por authorId, não a tela.
model OneOnOnePrivateNote {
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  body      String   @db.Text
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting OneOnOneMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User            @relation("OneOnOneNotes", fields: [authorId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id])

  @@unique([meetingId, authorId])
  @@index([companyId])
}

/// O combinado. Preso à SÉRIE (logo, ao par): aparece em todo encontro do par
/// até fechar. `promotedPdiActionId` guarda a PdiAction que nasceu dele.
model OneOnOneAction {
  id                  String               @id @default(cuid())
  seriesId            String
  createdInMeetingId  String
  description         String
  ownerId             String
  dueDate             DateTime?
  status              OneOnOneActionStatus @default(OPEN)
  completedById       String?
  completedAt         DateTime?
  promotedPdiActionId String?              @unique
  companyId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  series            OneOnOneSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdInMeeting  OneOnOneMeeting @relation("OneOnOneActionCreatedIn", fields: [createdInMeetingId], references: [id], onDelete: Cascade)
  owner             User            @relation("OneOnOneActionsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  completedBy       User?           @relation("OneOnOneActionsCompleted", fields: [completedById], references: [id])
  promotedPdiAction PdiAction?      @relation("OneOnOnePromotedAction", fields: [promotedPdiActionId], references: [id], onDelete: SetNull)
  company           Company         @relation(fields: [companyId], references: [id])

  @@index([seriesId, status])
  @@index([companyId, ownerId, status])
}

/// Catálogo de tópicos sugeridos, cadastrado em Administração › Gente e Gestão.
model OneOnOneTopicTemplate {
  id        String   @id @default(cuid())
  theme     String
  text      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, active, sortOrder])
}
