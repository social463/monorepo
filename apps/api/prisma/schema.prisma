model RetroVote {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  card    RetroCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user    User      @relation("RetroVotes", fields: [userId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@index([cardId])
  @@index([userId])
  @@index([companyId])
}

model RetroReaction {
  id        String @id @default(cuid())
  cardId    String
  userId    String
  emoji     String
  companyId String @default("company-emr")

  card    RetroCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user    User      @relation("RetroReactions", fields: [userId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@unique([cardId, userId, emoji])
  @@index([cardId])
  @@index([companyId])
}

model RetroEdit {
  id        String   @id @default(cuid())
  roomId    String
  editorId  String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  room    RetroRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  editor  User      @relation("RetroEditsAuthored", fields: [editorId], references: [id])
  company Company   @relation(fields: [companyId], references: [id])

  @@index([roomId])
  @@index([companyId])
}

model MoodEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      MoodLevel
  note      String? // nota opcional: "o que te faz sentir assim"
  reason    MoodReason? // categoria do mal-estar; só preenchida em humor negativo
  day       DateTime    @db.Date // data civil em America/Sao_Paulo
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  companyId String      @default("company-emr")
  company   Company     @relation(fields: [companyId], references: [id])

  @@unique([userId, day])
  @@index([userId, day])
  @@index([companyId])
  // Recortes do painel de clima: janela de dias dentro da empresa.
  @@index([companyId, day])
}

/// Regra de premiação em EMR Coins por evento. O CATÁLOGO de eventos é do código
/// (enum CoinEvent, instrumentado nas rotas); a REGRA é dado, com CRUD do admin.
/// Sem condições: só evento + valor + teto por janela.
model CoinRule {
  id        String        @id @default(cuid())
  event     CoinEvent
  amount    Int
  capWindow CoinCapWindow @default(NONE)
  /// Teto de coins pagos por ESTA regra dentro da janela. null quando capWindow = NONE.
  capAmount Int?
  active    Boolean       @default(true)
  companyId String        @default("company-emr")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company      Company           @relation(fields: [companyId], references: [id])
  transactions CoinTransaction[]

  @@unique([companyId, event])
  @@index([companyId])
}

/// Livro-razão de EMR Coins. Append-only: saldo = SUM(amount), sem coluna materializada.
model CoinTransaction {
  id        String              @id @default(cuid())
  userId    String
  kind      CoinTransactionKind
  /// Evento que gerou o crédito automático; null em ajuste manual. DENORMALIZADO de
  /// propósito: o relatório continua correto depois que a regra é apagada.
  event     CoinEvent?
  /// Regra vigente no crédito; vira null se a regra for apagada (SetNull) — o
  /// lançamento nunca some do extrato.
  ruleId    String?
  /// Positivo credita, negativo debita (MANUAL_DEBIT é sempre negativo).
  amount    Int
  /// Justificativa obrigatória do ajuste manual; null em crédito automático.
  reason    String?
  /// Admin autor do ajuste manual; null em crédito automático.
  actorId   String?
  /// Idempotência: `${event}:${referência da ação}` no automático, `MANUAL:<uuid>` no
  /// manual. NUNCA null, e por isso a unique abaixo é a padrão (NULLS DISTINCT).
  /// Não copiar o NULLS NOT DISTINCT de UserBadge: com dedupeKey nulo nos ajustes,
  /// o segundo ajuste manual do mesmo usuário quebraria com P2002.
  dedupeKey String
  /// Dia civil em America/Sao_Paulo (mesmo formato de MoodEntry.day). Janela de teto e
  /// filtro do relatório saem daqui, nunca de createdAt — a conta de fuso fica fora da query.
  day       DateTime            @db.Date
  createdAt DateTime            @default(now())
  companyId String              @default("company-emr")

  user    User      @relation("CoinTransactions", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?     @relation("CoinAdjustmentsMade", fields: [actorId], references: [id], onDelete: SetNull)
  rule    CoinRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  company Company   @relation(fields: [companyId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, ruleId, day])
  @@index([companyId])
  @@index([ruleId])
}

/// Pontos (XP) — progressão do colaborador.
///
/// Vizinho de CoinRule/CoinTransaction e de propósito um domínio separado: coin
/// é SALDO (a loja debita), XP é ACUMULADO e nunca é debitado. Nível derivado de
/// saldo cairia quando a pessoa comprasse algo. Por isso não há `kind` aqui: só
/// existe ganho, e nenhuma rota escreve valor negativo.
model XpRule {
  id        String      @id @default(cuid())
  event     XpEvent
  amount    Int
  capWindow XpCapWindow @default(NONE)
  /// Teto de XP pago por ESTA regra dentro da janela. null quando capWindow = NONE.
  capAmount Int?
  active    Boolean     @default(true)
  companyId String      @default("company-emr")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  transactions XpTransaction[]

  @@unique([companyId, event])
  @@index([companyId])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  /// Evento que gerou o crédito. DENORMALIZADO de propósito, como em
  /// CoinTransaction: o extrato continua correto depois que a regra é apagada.
  event     XpEvent
  /// Regra vigente no crédito; vira null se a regra for apagada (SetNull).
  ruleId    String?
  /// Sempre positivo — ver o comentário do model.
  amount    Int
  /// Idempotência: `${event}:${referência da ação}`. NUNCA null, e por isso a
  /// unique abaixo é a padrão (NULLS DISTINCT).
  dedupeKey String
  /// Dia civil em America/Sao_Paulo, como em CoinTransaction.day. A janela do
  /// teto sai daqui, nunca de createdAt — a conta de fuso fica fora da query.
  day       DateTime @db.Date
  createdAt DateTime @default(now())
  companyId String   @default("company-emr")

  user    User    @relation("XpTransactions", fields: [userId], references: [id], onDelete: Cascade)
  rule    XpRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, ruleId, day])
  @@index([companyId])
  @@index([ruleId])
}

