  FEEDBACK_RECEIVED
  FEEDBACK_REACTION
  BADGE_EARNED
  HIGHLIGHT_PUBLISHED
  DEVELOPMENT_THURSDAY_EVENT
  PERIOD_OPENED
  PERIOD_CLOSED
  RETRO_INVITED
  STREAK_AT_RISK
  VOTE_REMINDER_MIDWAY
