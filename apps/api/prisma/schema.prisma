generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEGEND
  LEAD
  MANAGER
  HEAD
  ADMIN
  SUBADMIN
  THIRD_PARTY
  SUPER_ADMIN
}

enum VotingPeriodStatus {
  OPEN
  CLOSED
}

enum HighlightStatus {
  NONE
  DRAFT
  PUBLISHED
}

enum BadgeKind {
  CATEGORY
  RECURRENCE
  IMPACT
  HIGHLIGHT
  FEEDBACK
  TENURE
  STREAK
  /// Cursos concluídos na área de Aprendizado.
  COURSE
  /// Ações de PDI concluídas (aprovadas, quando o líder valida).
  PDI
}

/// Ações instrumentadas que podem creditar EMR Coins. Cada valor corresponde a um
/// ponto de chamada de `awardCoins` numa rota — evento novo exige código novo.
enum CoinEvent {
  VOTE_CAST
  FEEDBACK_PUBLISHED
  FEEDBACK_REACTION
  MOOD_ANSWERED
  CHALLENGE_APPROVED
}

/// Janela em que o teto de uma regra é contado (dia civil de America/Sao_Paulo).
enum CoinCapWindow {
  NONE
  DAY
  WEEK
  MONTH
}

/// Espelha CoinEvent: os pontos instrumentados são os mesmos. Enum próprio (e
/// não CoinEvent reaproveitado) para os catálogos poderem divergir sem que
/// mexer num obrigue a mexer no outro.
enum XpEvent {
  VOTE_CAST
  FEEDBACK_PUBLISHED
  FEEDBACK_REACTION
  MOOD_ANSWERED
  CHALLENGE_APPROVED
  CORPORATE_POST_REACTION
  CORPORATE_POST_COMMENT
  CORPORATE_POST_READ_FULL
}

enum CorporatePostStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum CorporatePostAudience {
  ALL
  SECTORS
}

enum CorporatePostAttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum XpCapWindow {
  NONE
  DAY
  WEEK
  MONTH
}

enum CoinTransactionKind {
  EARN
  MANUAL_CREDIT
  MANUAL_DEBIT
  /// Resgate na loja: amount negativo.
  SPEND
  /// Estorno de resgate cancelado: amount positivo.
  REFUND
}

/// Ciclo de vida do pedido de resgate. As transições válidas vivem em
/// STORE_ORDER_TRANSITIONS (@legends/shared) — o banco só guarda o estado.
enum StoreOrderStatus {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}

enum BadgeAwardSource {
  AUTO
  MANUAL
}

enum MoodLevel {
  GREAT
  GOOD
  NEUTRAL
  LOW
  HARD
}

// Categoria opcional do mal-estar, escolhida junto com um humor negativo.
// Registros anteriores a este campo ficam nulos ("Não informado") — sem backfill.
enum MoodReason {
  WORKLOAD
  LEADERSHIP
  PROCESSES
  PERSONAL
  OTHER
  COMMUNICATION
  TOOLS
  /// Legado: saiu da lista oferecida, mas há respostas gravadas e o painel de
  /// clima agrega por motivo — apagar do enum apagaria a série histórica.
  RECOGNITION
  /// Legado, mesmo motivo de RECOGNITION.
  TEAM
}

// Área de atuação do colaborador. Usada para o manager ver o humor apenas
// de quem faz parte da sua área (engenharia ou produto).
enum Area {
  ENGINEERING
  PRODUCT
}

enum OfficeRoomStatus {
  OPEN
  LOCKED
}

enum OfficeRoomAccessPolicy {
  OPEN
  ALLOWLIST
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum CalendarConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String
  name                  String
  position              String?
  squad                 String?
  photoUrl              String?
  avatarStyle           String?
  avatarSeed            String?
  avatarOptions         Json?
  officeCharacterName   String?
  teamsWebhookUrl       String?
  role                  UserRole              @default(LEGEND)
  // Acesso administrativo delegado: abre o painel de admin com poder pleno, sem
  // mexer na `role`. Ortogonal ao papel — a pessoa continua colaboradora no
  // produto inteiro (vota, entra em squad, participa de retro). Ver
  // `packages/shared/src/permissions.ts`.
  adminAccess           Boolean               @default(false)
  // Líder direto: é o que desenha o organograma. Pode cruzar setor de propósito
  // (uma coordenadora de Operações pode responder à head de Gente e Gestão).
  managerId             String?
  sectorId              String                @default("sector-dev-produto")
  companyId             String                @default("company-emr")
  enabledFeatures       Json                  @default("[]")
  area                  Area?
  active                Boolean               @default(true)
  leftAt                DateTime?
  joinedAt              DateTime              @default(now())
  // Data civil de nascimento (sem hora/fuso). Alimenta os "Aniversariantes do dia".
  birthDate             DateTime?             @db.Date
  // Quem enxerga a vitrine de desenvolvimento (ações de PDI concluídas) desta pessoa.
  pdiShowcaseVisibility PdiShowcaseVisibility @default(TEAM)
  // Último sinal de vida na plataforma. Alimenta a bolinha de presença do
  // ranking; a janela do que conta como "on-line" é do código
  // (`PRESENCE_ONLINE_WINDOW_MINUTES`), não do banco.
  //
  // Coluna crua, e não uma tabela de sessões: o dado é sempre o ÚLTIMO sinal,
  // nunca o histórico — histórico de navegação já é `AccessLog`.
  lastSeenAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  sector                      Sector                     @relation(fields: [sectorId], references: [id])
  company                     Company                    @relation(fields: [companyId], references: [id])
  manager                     User?                      @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                     User[]                     @relation("UserManager")
  votesGiven                  Vote[]                     @relation("VotesGiven")
  votesReceived               Vote[]                     @relation("VotesReceived")
  badges                      UserBadge[]
  badgesAwarded               UserBadge[]                @relation("BadgesAwarded")
  periodsWon                  VotingPeriod[]             @relation("PeriodWinner")
  refreshTokens               RefreshToken[]
  monthlyHighlights           MonthlyHighlight[]         @relation("MonthlyHighlightPerson")
  monthlyHighlightsCreated    MonthlyHighlight[]         @relation("MonthlyHighlightCreator")
  feedbacksGiven              Feedback[]                 @relation("FeedbacksGiven")
  feedbacksReceived           Feedback[]                 @relation("FeedbacksReceived")
  feedbackRecipients          FeedbackRecipient[]
  feedbackComments            FeedbackComment[]
  feedbackReactions           FeedbackReaction[]
  notifications               Notification[]             @relation("UserNotifications")
  notificationsTriggered      Notification[]             @relation("NotificationActor")
  officeDeskRemindersSent     OfficeDeskReminder[]       @relation("OfficeDeskReminderSender")
  officeDeskRemindersReceived OfficeDeskReminder[]       @relation("OfficeDeskReminderRecipient")
  developmentThursdayEvents   DevelopmentThursdayEvent[] @relation("DevelopmentThursdayPresenter")

  retroRoomsCreated             RetroRoom[]                    @relation("RetroRoomsCreated")
  retroRoomsArchived            RetroRoom[]                    @relation("RetroRoomsArchived")
  retroTimerUpdates             RetroRoom[]                    @relation("RetroTimerUpdatedBy")
  retroParticipations           RetroParticipant[]             @relation("RetroParticipations")
  retroCards                    RetroCard[]                    @relation("RetroCards")
  retroVotes                    RetroVote[]                    @relation("RetroVotes")
  retroReactions                RetroReaction[]                @relation("RetroReactions")
  auditedActions                RetroCard[]                    @relation("RetroActionsAudited")
  editedRetroCards              RetroCard[]                    @relation("RetroCardsEdited")
  retroEditsAuthored            RetroEdit[]                    @relation("RetroEditsAuthored")
  squadMemberships              SquadMember[]                  @relation("SquadMemberships")
  ledSquads                     Squad[]                        @relation("SquadLeader")
  companyResponsibilities       CompanyResponsible[]
  sectorsResponsibleFor         Sector[]                       @relation("SectorResponsible")
  moodEntries                   MoodEntry[]
  calendarConnections           CalendarConnection[]
  reviews                       Review[]                       @relation("ReviewsAuthored")
  campaignsCreated              Campaign[]                     @relation("CampaignsCreated")
  campaignPostsAssigned         CampaignPost[]                 @relation("CampaignPostsResponsible")
  reviewComments                ReviewComment[]                @relation("ReviewCommentsAuthored")
  reviewReactions               ReviewReaction[]
  reviewCommentReactions        ReviewCommentReaction[]
  reviewShares                  ReviewShare[]
  reviewMentions                ReviewMention[]
  reviewCommentMentions         ReviewCommentMention[]
  reviewPollVotes               ReviewPollVote[]
  corporatePosts                CorporatePost[]                @relation("CorporatePostsAuthored")
  corporatePostComments         CorporatePostComment[]         @relation("CorporatePostCommentsAuthored")
  corporatePostReactions        CorporatePostReaction[]
  corporatePostCommentReactions CorporatePostCommentReaction[]
  corporatePostMentions         CorporatePostMention[]
  corporatePostCommentMentions  CorporatePostCommentMention[]
  corporatePostsPinned          CorporatePost[]                @relation("CorporatePostsPinned")
  corporatePostsReviewed        CorporatePost[]                @relation("CorporatePostsReviewed")
  corporatePostReads            CorporatePostRead[]            @relation("CorporatePostReads")
  officeMapDraftsEdited         OfficeMapDraft[]               @relation("OfficeMapDraftEditor")
  officeMapAssetsCreated        OfficeMapAsset[]               @relation("OfficeMapAssetCreator")
  officeMapLocks                OfficeMapEditLock[]            @relation("OfficeMapLockOwner")
  officeMapPublications         OfficeMapPublication[]         @relation("OfficeMapPublicationCreator")
  officeMapDecorRevisions       OfficeMapDecorRevision[]       @relation("OfficeMapDecorRevisionCreator")
  officeRoomGrants              OfficeRoomAccessGrant[]
  officeDeskClaim               OfficeDeskClaim?
  officeMeetingsOrganized       OfficeMeeting[]                @relation("OfficeMeetingOrganizer")
  officeMeetingSeats            OfficeMeetingParticipant[]     @relation("OfficeMeetingParticipant")
  characterFavorites            CharacterFavorite[]
  officeGuestInvitesCreated     OfficeGuestInvite[]            @relation("OfficeGuestInviteCreator")
  thirdPartyInvitesCreated      ThirdPartyInvite[]             @relation("ThirdPartyInvitesCreated")
  adminAuditLogs                AdminAuditLog[]                @relation("AdminAuditActor")
  culturePagesUpdated           CulturePage[]                  @relation("CulturePagesUpdated")
  culturePersonalAssetsReceived CulturePersonalAsset[]         @relation("CulturePersonalAssetsReceived")
  culturePersonalAssetsCreated  CulturePersonalAsset[]         @relation("CulturePersonalAssetsCreated")
  coinTransactions              CoinTransaction[]              @relation("CoinTransactions")
  coinAdjustmentsMade           CoinTransaction[]              @relation("CoinAdjustmentsMade")
  xpTransactions                XpTransaction[]                @relation("XpTransactions")
  vacations                     Vacation[]                     @relation("Vacations")
  vacationsCreated              Vacation[]                     @relation("VacationsCreated")
  accessLogs                    AccessLog[]                    @relation("AccessLogs")
  analyticsEvents               AnalyticsEvent[]               @relation("AnalyticsEvents")
  hrDashboards                  HrDashboard[]
  knowledgeEntries              KnowledgeEntry[]               @relation("KnowledgeEntryAuthor")
  assistantQueries              AssistantQuery[]               @relation("AssistantQueryAuthor")
  assistantFeedbacks            AssistantFeedback[]            @relation("AssistantFeedbackAuthor")

  courseEnrollments    CourseEnrollment[]  @relation("CourseEnrollments")
  lessonProgress       LessonProgress[]    @relation("LessonProgress")
  courseFavorites      CourseFavorite[]    @relation("CourseFavorites")
  courseRatings        CourseRating[]      @relation("CourseRatings")
  certificates         Certificate[]       @relation("Certificates")
  pdiPlans             PdiPlan[]           @relation("PdiPlans")
  pdiPlansLed          PdiPlan[]           @relation("PdiPlansLed")
  pdiActionsReviewed   PdiAction[]         @relation("PdiActionsReviewed")
  pdiEvidencesUploaded PdiActionEvidence[] @relation("PdiEvidencesUploaded")
  pdiActionEvents      PdiActionHistory[]  @relation("PdiActionEvents")

  quizAttempts                QuizAttempt[]        @relation("QuizAttempts")
  certificateRequests         CertificateRequest[] @relation("CertificateRequestUser")
  certificateRequestsReviewed CertificateRequest[] @relation("CertificateRequestReviewedBy")

  benchmarkPracticesCreated    BenchmarkPractice[]   @relation("BenchmarkPracticesCreated")
  glassReviewsCreated          GlassReview[]         @relation("GlassReviewsCreated")
  agentConversations           AgentConversation[]   @relation("AgentConversations")
  challengesCreated            Challenge[]           @relation("ChallengesCreated")
  challengeSubmissions         ChallengeSubmission[] @relation("ChallengeSubmissions")
  challengeSubmissionsReviewed ChallengeSubmission[] @relation("ChallengeSubmissionsReviewed")

  storeProductsCreated StoreProduct[]       @relation("StoreProductsCreated")
  storeOrders          StoreOrder[]         @relation("StoreOrders")
  storeOrdersHandled   StoreOrder[]         @relation("StoreOrdersHandled")
  eventAlbumsCreated   EventAlbum[]         @relation("EventAlbumsCreated")
  eventPhotosUploaded  EventPhoto[]         @relation("EventPhotosUploaded")
  eventPhotoReactions  EventPhotoReaction[] @relation("EventPhotoReactions")
  eventPhotoComments   EventPhotoComment[]  @relation("EventPhotoComments")

  calendarEventsCreated CalendarEvent[] @relation("CalendarEventsCreated")

  oneOnOneAsUserA          OneOnOneSeries[]      @relation("OneOnOneUserA")
  oneOnOneAsUserB          OneOnOneSeries[]      @relation("OneOnOneUserB")
  oneOnOneCreated          OneOnOneSeries[]      @relation("OneOnOneCreated")
  oneOnOneTopics           OneOnOneTopic[]       @relation("OneOnOneTopicsCreated")
  oneOnOneNotes            OneOnOnePrivateNote[] @relation("OneOnOneNotes")
  oneOnOneActionsOwned     OneOnOneAction[]      @relation("OneOnOneActionsOwned")
  oneOnOneActionsCompleted OneOnOneAction[]      @relation("OneOnOneActionsCompleted")

  @@index([companyId])
  @@index([managerId])
  // Presença: a consulta é sempre "quem desta empresa foi visto depois de X".
  @@index([companyId, lastSeenAt])
}

model OfficeGuestInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companyId   String    @default("company-emr")

  createdBy User    @relation("OfficeGuestInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id])

  @@index([createdById])
  @@index([expiresAt])
  @@index([companyId])
}

model ThirdPartyInvite {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  createdById     String
  createdBy       User      @relation("ThirdPartyInvitesCreated", fields: [createdById], references: [id])
  enabledFeatures Json      @default("[]")
  sectorId        String    @default("sector-dev-produto")
  companyId       String    @default("company-emr")
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  sector  Sector  @relation(fields: [sectorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([sectorId])
  @@index([companyId])
}

model CharacterFavorite {
  id        String   @id @default(cuid())
  userId    String
  slot      Int
  seed      String
  options   Json
  signature String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String
  persistent Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model AppSetting {
  key       String
  companyId String   @default("company-emr")
  value     String?
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@id([key, companyId])
}

model DevelopmentThursdayEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  sprintStart DateTime @db.Date
  sprintEnd   DateTime @db.Date
  eventDate   DateTime @db.Date
  startTime   String?
  endTime     String?
  presenterId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("company-emr")

  presenter User       @relation("DevelopmentThursdayPresenter", fields: [presenterId], references: [id])
  feedbacks Feedback[]
  company   Company    @relation(fields: [companyId], references: [id])

  @@unique([sprintStart, companyId])
  @@index([eventDate])
  @@index([presenterId])
  @@index([companyId])
}

model Squad {
  id        String   @id @default(cuid())
  /// Nome e slug são únicos **por empresa** — ver o comentário em `Badge.slug`.
  name      String
  slug      String
  active    Boolean  @default(true)
  leaderId  String?
  sectorId  String   @default("sector-dev-produto")
  companyId String   @default("company-emr")
  createdAt DateTime @default(now())

  leader  User?            @relation("SquadLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  sector  Sector           @relation(fields: [sectorId], references: [id])
  company Company          @relation(fields: [companyId], references: [id])
  members SquadMember[]
  rooms   RetroRoomSquad[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([leaderId])
  @@index([sectorId])
  @@index([companyId])
}

model SquadMember {
  id       String   @id @default(cuid())
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation("SquadMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
}

model Sector {
  id              String   @id @default(cuid())
  name            String
  /// Único **por empresa** — ver o comentário em `Badge.slug`. Duas empresas
  /// cadastrarem "Engenharia" é o caso normal, não colisão.
  slug            String
  active          Boolean  @default(true)
  enabledFeatures Json     @default("[]")
  companyId       String   @default("company-emr")
  responsibleId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id])
  responsible            User?                   @relation("SectorResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  users                  User[]
  roles                  SectorRole[]
  votingPeriods          VotingPeriod[]
  squads                 Squad[]
  badgeSectors           BadgeSector[]
  thirdPartyInvites      ThirdPartyInvite[]
  reviews                Review[]
  reviewComments         ReviewComment[]
  reviewReactions        ReviewReaction[]
  monthlyHighlights      MonthlyHighlight[]
  reviewCommentReactions ReviewCommentReaction[]
  reviewShares           ReviewShare[]
  reviewMentions         ReviewMention[]
  corporatePostSectors   CorporatePostSector[]
  reviewCommentMentions  ReviewCommentMention[]
  reviewPolls            ReviewPoll[]
  reviewPollOptions      ReviewPollOption[]
  reviewPollVotes        ReviewPollVote[]
  hrDashboards           HrDashboard[]
  coursesScoped          Course[]                @relation("CourseSector")
  knowledgeEntries       KnowledgeEntry[]
  challenges             Challenge[]
  calendarEvents         CalendarEventSector[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([responsibleId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectors                       Sector[]
  users                         User[]
  responsibles                  CompanyResponsible[]
  votingPeriods                 VotingPeriod[]
  votes                         Vote[]
  squads                        Squad[]
  thirdPartyInvites             ThirdPartyInvite[]
  badges                        Badge[]
  feedbacks                     Feedback[]
  feedbackReactions             FeedbackReaction[]
  feedbackRecipients            FeedbackRecipient[]
  feedbackComments              FeedbackComment[]
  feedbackRecognitionCategories FeedbackRecognitionCategory[]
  recognitionCategories         RecognitionCategory[]
  monthlyHighlights             MonthlyHighlight[]
  moodEntries                   MoodEntry[]
  coinRules                     CoinRule[]
  coinTransactions              CoinTransaction[]
  xpRules                       XpRule[]
  xpTransactions                XpTransaction[]
  notifications                 Notification[]
  calendarConnections           CalendarConnection[]
  reviews                       Review[]
  reviewComments                ReviewComment[]
  reviewReactions               ReviewReaction[]
  reviewCommentReactions        ReviewCommentReaction[]
  reviewShares                  ReviewShare[]
  reviewMentions                ReviewMention[]
  reviewCommentMentions         ReviewCommentMention[]
  reviewPolls                   ReviewPoll[]
  reviewPollOptions             ReviewPollOption[]
  reviewPollVotes               ReviewPollVote[]
  corporatePosts                CorporatePost[]
  corporatePostComments         CorporatePostComment[]
  corporatePostReactions        CorporatePostReaction[]
  corporatePostCommentReactions CorporatePostCommentReaction[]
  corporatePostMentions         CorporatePostMention[]
  corporatePostCommentMentions  CorporatePostCommentMention[]
  corporatePostReads            CorporatePostRead[]
  corporatePostSectors          CorporatePostSector[]
  corporatePostAttachments      CorporatePostAttachment[]
  userBadges                    UserBadge[]
  retroRooms                    RetroRoom[]
  retroRoomSquads               RetroRoomSquad[]
  retroParticipants             RetroParticipant[]
  retroCards                    RetroCard[]
  retroVotes                    RetroVote[]
  retroReactions                RetroReaction[]
  retroEdits                    RetroEdit[]

  officeSetting              OfficeSetting?
  officeMaps                 OfficeMap[]
  officeMapDrafts            OfficeMapDraft[]
  officeMapAssets            OfficeMapAsset[]
  officeMapEditLocks         OfficeMapEditLock[]
  officeMapPublications      OfficeMapPublication[]
  officeMapPublicationAssets OfficeMapPublicationAsset[]
  officeMapDecorRevisions    OfficeMapDecorRevision[]
  officeRooms                OfficeRoom[]
  officeRoomAccessGrants     OfficeRoomAccessGrant[]
  officeDesks                OfficeDesk[]
  officeDeskClaims           OfficeDeskClaim[]
  officeDeskReminders        OfficeDeskReminder[]
  officeGuestInvites         OfficeGuestInvite[]
  officeMeetings             OfficeMeeting[]
  adminAuditLogs             AdminAuditLog[]
  developmentThursdayEvents  DevelopmentThursdayEvent[]
  appSettings                AppSetting[]

  culturePages          CulturePage[]
  cultureManuals        CultureManual[]
  cultureBenefits       CultureBenefit[]
  cultureVisualAssets   CultureVisualAsset[]
  culturePersonalAssets CulturePersonalAsset[]
  vacations             Vacation[]
  accessLogs            AccessLog[]
  analyticsEvents       AnalyticsEvent[]
  hrDashboards          HrDashboard[]
  knowledgeEntries      KnowledgeEntry[]
  assistantQueries      AssistantQuery[]
  assistantFeedbacks    AssistantFeedback[]

  courses              Course[]
  courseModules        CourseModule[]
  courseLessons        CourseLesson[]
  courseEnrollments    CourseEnrollment[]
  lessonProgress       LessonProgress[]
  courseFavorites      CourseFavorite[]
  courseRatings        CourseRating[]
  learningTracks       LearningTrack[]
  learningTrackCourses LearningTrackCourse[]
  certificates         Certificate[]
  pdiPlans             PdiPlan[]
  pdiActions           PdiAction[]
  pdiActionEvidences   PdiActionEvidence[]
  pdiActionHistory     PdiActionHistory[]

  courseQuizzes        CourseQuiz[]
  courseQuestions      CourseQuestion[]
  quizAttempts         QuizAttempt[]
  certificateTemplates CertificateTemplate[]
  certificateRequests  CertificateRequest[]

  benchmarkPractices   BenchmarkPractice[]
  glassReviews         GlassReview[]
  agentConversations   AgentConversation[]
  agentMessages        AgentMessage[]
  challenges           Challenge[]
  challengeSubmissions ChallengeSubmission[]

  storeProducts       StoreProduct[]
  storeOrders         StoreOrder[]
  campaigns           Campaign[]
  campaignPosts       CampaignPost[]
  eventAlbums         EventAlbum[]
  eventPhotos         EventPhoto[]
  eventPhotoReactions EventPhotoReaction[]
  eventPhotoComments  EventPhotoComment[]

  calendarEventTypes CalendarEventType[]
  calendarEvents     CalendarEvent[]

  oneOnOneSeries         OneOnOneSeries[]
  oneOnOneMeetings       OneOnOneMeeting[]
  oneOnOneTopics         OneOnOneTopic[]
  oneOnOneNotes          OneOnOnePrivateNote[]
  oneOnOneActions        OneOnOneAction[]
  oneOnOneTopicTemplates OneOnOneTopicTemplate[]
}

model CompanyResponsible {
  companyId String
  userId    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
}

enum AdminAuditAction {
  CREATE
  UPDATE
  DELETE
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     AdminAuditAction
  before     Json?
  after      Json?
  createdAt  DateTime         @default(now())
  companyId  String           @default("company-emr")

  actor   User    @relation("AdminAuditActor", fields: [actorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId])
}

model SectorRole {
  sectorId String
  role     UserRole

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([sectorId, role])
}

model VotingPeriod {
  id        String             @id @default(cuid())
  monthRef  String // formato "2026-06"; único POR SETOR (ver @@unique abaixo)
  sectorId  String             @default("sector-dev-produto")
  companyId String             @default("company-emr")
  startsAt  DateTime
  endsAt    DateTime
  status    VotingPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now())

  winnerId           String?
  winnerVotes        Int?
  highlightMonthRef  String?
  highlightText      String?
  highlightImagePath String?
  highlightStatus    HighlightStatus @default(NONE)

  votes   Vote[]
  winner  User?   @relation("PeriodWinner", fields: [winnerId], references: [id])
  sector  Sector  @relation(fields: [sectorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([sectorId, monthRef], name: "one_period_per_sector_month", map: "one_period_per_sector_month")
  @@index([companyId])
}

/// Destaque do mês CURADO pela G&G — uma linha por (mês, pessoa).
///
/// Não é o Destaque do Mês da votação, que vive em `VotingPeriod` (winnerId,
/// highlightText, card de IA) e continua existindo: lá o vencedor sai dos votos
/// e é um por setor; aqui a escolha é editorial e o mês tem quantas pessoas a
/// G&G quiser. Pendurar isto no período amarraria o reconhecimento ao ciclo da
/// votação — janela, status e a unique de um vencedor por setor.
model MonthlyHighlight {
  id          String   @id @default(cuid())
  /// "AAAA-MM", o mesmo formato do `monthRef` da votação.
  monthRef    String
  userId      String
  /// SNAPSHOT do setor no cadastro: quem muda de setor em março não reescreve
  /// o quadro de janeiro. Mesmo princípio do `sectorId` de `AnalyticsEvent`.
  sectorId    String
  /// Justificativa — o texto que hoje a G&G manda por fora. Opcional porque o
  /// quadro costuma sair antes de a justificativa individual ficar pronta.
  message     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("company-emr")

  user      User    @relation("MonthlyHighlightPerson", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MonthlyHighlightCreator", fields: [createdById], references: [id])
  sector    Sector  @relation(fields: [sectorId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, monthRef, userId])
  @@index([companyId, monthRef])
  @@index([userId])
}

model Vote {
  id            String   @id @default(cuid())
  voterId       String
  votedId       String
  periodId      String
  companyId     String   @default("company-emr")
  justification String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voter      User           @relation("VotesGiven", fields: [voterId], references: [id])
  voted      User           @relation("VotesReceived", fields: [votedId], references: [id])
  period     VotingPeriod   @relation(fields: [periodId], references: [id])
  company    Company        @relation(fields: [companyId], references: [id])
  categories VoteCategory[]
  feedback   Feedback?

  @@unique([voterId, periodId], name: "one_vote_per_voter_period")
  @@index([periodId])
  @@index([votedId])
  @@index([companyId])
}

model VoteCategory {
  voteId     String
  categoryId String

  vote     Vote                @relation(fields: [voteId], references: [id], onDelete: Cascade)
  category RecognitionCategory @relation(fields: [categoryId], references: [id])

  @@id([voteId, categoryId])
  @@index([categoryId])
}

model Badge {
  id           String    @id @default(cuid())
  /// Único **por empresa**, não no banco inteiro: num produto white label o
  /// selo "Inovador" da empresa A não pode impedir a empresa B de ter o dela —
  /// e o `destaque-do-mes`, que o `publishHighlight` procura por slug, precisa
  /// existir uma vez em cada empresa.
  slug         String
  name         String
  description  String
  kind         BadgeKind
  iconKey      String
  threshold    Int       @default(0)
  categorySlug String?
  global       Boolean   @default(true)
  companyId    String    @default("company-emr")

  company Company       @relation(fields: [companyId], references: [id])
  awarded UserBadge[]
  sectors BadgeSector[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model BadgeSector {
  badgeId  String
  sectorId String

  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([badgeId, sectorId])
}

model UserBadge {
  id          String           @id @default(cuid())
  userId      String
  badgeId     String
  periodId    String?
  source      BadgeAwardSource @default(AUTO)
  awardedById String?
  awardedAt   DateTime         @default(now())
  featured    Boolean          @default(false)
  companyId   String           @default("company-emr")

  user      User    @relation(fields: [userId], references: [id])
  badge     Badge   @relation(fields: [badgeId], references: [id])
  awardedBy User?   @relation("BadgesAwarded", fields: [awardedById], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  /// Índice é NULLS NOT DISTINCT (ver migration 20260612180000) — bloqueia concessão manual duplicada com periodId null.
  @@unique([userId, badgeId, periodId])
  @@index([userId])
  @@index([companyId])
}

enum FeedbackCategory {
  POSITIVO
  ORIENTACAO
  ELOGIO
  MELHORIA
}

