  userId      String
  badgeId     String
  periodId    String?
  source      BadgeAwardSource @default(AUTO)
  awardedById String?
  awardedAt   DateTime         @default(now())
  featured    Boolean          @default(false)
  companyId   String           @default("company-emr")

  user      User    @relation(fields: [userId], references: [id])
  badge     Badge   @relation(fields: [badgeId], references: [id])
  awardedBy User?   @relation("BadgesAwarded", fields: [awardedById], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  /// Índice é NULLS NOT DISTINCT (ver migration 20260612180000) — bloqueia concessão manual duplicada com periodId null.
  @@unique([userId, badgeId, periodId])
  @@index([userId])
  @@index([companyId])
}

enum FeedbackCategory {
  POSITIVO
  ORIENTACAO
  ELOGIO
  MELHORIA
}

enum NotificationType {
  FEEDBACK_RECEIVED
  FEEDBACK_REACTION
  /// Alguém respondeu a um feedback — do perfil ou do mural, é a mesma conversa.
  FEEDBACK_COMMENT
  BADGE_EARNED
  /// Reivindicação de selo recusada pela G&G, com o motivo (Documento 4, 11.2).
  /// Aprovada não precisa de tipo próprio: ela vira BADGE_EARNED, que é o que a
  /// pessoa quer ler.
  BADGE_CLAIM_REJECTED
  HIGHLIGHT_PUBLISHED
  /// Alguém assinou o mural de aniversário da pessoa.
  BIRTHDAY_GREETING_RECEIVED
  DEVELOPMENT_THURSDAY_EVENT
  PERIOD_OPENED
  PERIOD_CLOSED
  RETRO_INVITED
  STREAK_AT_RISK
  VOTE_REMINDER_MIDWAY
  VOTE_REMINDER_CLOSING
  REVIEW_COMMENT
  REVIEW_COMMENT_REPLY
  REVIEW_REACTION
  REVIEW_SHARED
  REVIEW_MENTION
  REVIEW_POLL_PUBLISHED
  MEETING_INVITED
  MEETING_UPDATED
  MEETING_CANCELED
  MEETING_REMINDER
  CORPORATE_POST_COMMENT
  CORPORATE_POST_COMMENT_REPLY
  CORPORATE_POST_REACTION
  CORPORATE_POST_MENTION
  CORPORATE_POST_PUBLISHED
  CORPORATE_POST_AWAITING_REVIEW
  CORPORATE_POST_APPROVED
  CORPORATE_POST_REJECTED
  OFFICE_DESK_REMINDER_RECEIVED
  OFFICE_DESK_REMINDER_READ
  PDI_ACTION_AWAITING_REVIEW
  PDI_ACTION_APPROVED
  PDI_ACTION_CHANGES_REQUESTED
  MANDATORY_COURSE_ASSIGNED
  /// Validação do registro de treinamento pela G&G (módulo de T&D). Dois tipos
  /// e não um com flag: a recusa leva o motivo no título e pede ação de quem
  /// recebeu, a validação só informa.
  TRAINING_VALIDATED
  TRAINING_REJECTED
  CERTIFICATE_APPROVED
  CHALLENGE_SUBMISSION_APPROVED
  CHALLENGE_SUBMISSION_REJECTED
  STORE_ORDER_APPROVED
  STORE_ORDER_DELIVERED
  STORE_ORDER_CANCELLED
  CALENDAR_EVENT_REMINDER
  CALENDAR_EVENT_INVITED
  ONE_ON_ONE_INVITED
  ONE_ON_ONE_ACTION_ASSIGNED
  ONE_ON_ONE_REMINDER
  ONE_ON_ONE_RESPONDED
  ONE_ON_ONE_PROPOSAL_ACCEPTED
  ONE_ON_ONE_PROPOSAL_DECLINED
  /// A programação de férias da pessoa foi validada pela G&G. É o aviso que a
  /// G&G pediu no lugar do recibo assinado, que segue com a Contabilidade.
  VACATION_PLAN_VALIDATED
  /// Cobrança do prazo da campanha, para o gestor com gente sem programar. É o
  /// que substitui a G&G caçando gestor por e-mail.
  VACATION_PLAN_DEADLINE
}

enum RetroRoomStatus {
  OPEN
  CONCLUDED
}

enum RetroTimerMode {
  ELAPSED
  COUNTDOWN
}

enum RetroTimerStatus {
  IDLE
  RUNNING
  PAUSED
}

model Feedback {
  id                         String           @id @default(cuid())
  authorId                   String
  targetId                   String
  /// Voto que originou este feedback, quando ele nasceu da votação. Único: a
  /// materialização roda a cada publicação de destaque e não pode duplicar.
  voteId                     String?          @unique
  message                    String
  category                   FeedbackCategory
  /// Competência escrita à mão, quando o catálogo da G&G não cobre o caso.
  /// Vive fora do catálogo de propósito: é exceção, não item administrável.
  customCategory             String?
  developmentThursdayEventId String?
  sharedAt                   DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  companyId                  String           @default("company-emr")

  author                   User                          @relation("FeedbacksGiven", fields: [authorId], references: [id])
  target                   User                          @relation("FeedbacksReceived", fields: [targetId], references: [id])
  vote                     Vote?                         @relation(fields: [voteId], references: [id], onDelete: SetNull)
  developmentThursdayEvent DevelopmentThursdayEvent?     @relation(fields: [developmentThursdayEventId], references: [id], onDelete: SetNull)
  reactions                FeedbackReaction[]
  recipients               FeedbackRecipient[]
  recognitionCategories    FeedbackRecognitionCategory[]
  comments                 FeedbackComment[]
  company                  Company                       @relation(fields: [companyId], references: [id])

  @@index([targetId])
  @@index([authorId])
  @@index([developmentThursdayEventId])
  @@index([targetId, category])
  @@index([sharedAt])
  @@index([companyId])
}

/// Destinatários de um feedback. O reconhecimento grupal é UM feedback com N
/// pessoas (e, portanto, UMA conversa de reações e comentários) — N feedbacks
/// independentes dariam N conversas paralelas sobre o mesmo texto.
///
/// O destinatário principal (`Feedback.targetId`, que continua existindo para o
/// perfil, a Quinta de Dev e os selos) entra AQUI TAMBÉM, de propósito: assim
/// toda leitura de "quem recebeu" tem um caminho só.
model FeedbackRecipient {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@unique([feedbackId, userId])
  @@index([userId])
  @@index([companyId])
}

/// Catálogo de competências administrado pela G&G (Administração ›
/// Reconhecimento). As 13 do documento entram por seed, não cravadas no código:
/// cada empresa ajusta a lista dela.
/// Catálogo único de categorias da empresa: vale para o feedback e para o voto.
/// Antes eram dois (este e `Category`, do voto) — ver
/// `specs/2026-08-20-unificar-reconhecimento-em-feedback-design.md`.
model RecognitionCategory {
  id          String   @id @default(cuid())
  name        String
  /// Identificador estável: o nome a G&G renomeia, o slug não. É por ele que
  /// `Badge.categorySlug` aponta e que o front escolhe o ícone.
  slug        String
  /// Texto de apoio no seletor de voto; herdado do catálogo aposentado.
  description String?
  /// Ordem de exibição no seletor; empate cai no nome.
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String   @default("company-emr")

  company        Company                       @relation(fields: [companyId], references: [id])
  feedbacks      FeedbackRecognitionCategory[]
  voteCategories VoteCategory[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
}

/// Competências de um feedback (N por feedback, escolhidas no envio).
model FeedbackRecognitionCategory {
  id         String @id @default(cuid())
  feedbackId String
  categoryId String
  companyId  String @default("company-emr")

  feedback Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  category RecognitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company             @relation(fields: [companyId], references: [id])

  @@unique([feedbackId, categoryId])
  @@index([categoryId])
  @@index([companyId])
}

/// Resposta pública a um feedback. Quem enxerga o feedback enxerga o
/// comentário — a checagem é a mesma `canViewFeedback`, sem caminho paralelo de
/// visibilidade para manter em dia.
model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String
  message    String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([feedbackId])
  @@index([companyId])
}

model FeedbackReaction {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())
  companyId  String   @default("company-emr")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
